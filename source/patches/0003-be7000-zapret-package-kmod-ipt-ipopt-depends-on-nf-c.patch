+	if [ ! -f "$ZAP_PKG_BASE_FN" ]; then
+		echo "ERROR: File \"${ZAPRET_CFG_NAME}*.${ZAP_PKG_EXT}\" not found!"
+		return 231
+	fi
+	echo "ZAP_PKG_BASE_FN = $ZAP_PKG_BASE_FN"
+	if [ ! -f "$ZAP_PKG_LUCI_FN" ]; then
