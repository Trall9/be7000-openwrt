+            if (txt) {
+                this.appendLog(txt.startsWith('ERROR') ? txt : 'ERROR: ' + txt);
+            } else {
+                this.appendLog('ERROR: ' + this._action + ': Terminated with error code = ' + rc);
+            }
+        } else {
+            this.appendLog('ERROR: Process finished with retcode = ' + rc);
+        }
+        this.appendLog('=========================================================');
+    },
