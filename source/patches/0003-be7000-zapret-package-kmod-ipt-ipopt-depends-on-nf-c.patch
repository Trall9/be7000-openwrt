+
+    installUpdates: async function(ev)
+    {
+        if (!this.pkg_url || this.pkg_url.length < 10) {
+            this.appendLog('ERROR: pkg_url = null');
+            this.setStage(9);
+            return;
+        }
+        this._action = 'installUpdates';
+        this.setStage(3);
