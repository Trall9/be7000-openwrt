+        resetcfg_btn.onclick = this.createServiceHandlerFn('reset', 'resetcfg_btn');
+
+        ui.showModal(_('Reset settings to default'), [
+            E('div', { 'class': 'cbi-section' }, [
+                reset_base,
+                E('br'), E('br'),
+                reset_ipset,
+                E('br'), E('br'),
+                set_autohostlist,
+                E('br'), E('br'),
+                erase_autohostlist,
+                E('br'), E('br'),
+                enable_custom_d,
+                E('br'), E('br'),
