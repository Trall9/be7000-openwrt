+                E('div', { 'class': 'right' }, [
+                    cancel_button,
+                ]),
+            ]),
+        ]);
+    },
+
+    load: function()
+    {
+        return tools.baseLoad(this, (data) => {
+            //console.log('SYS FEATURES: '+JSON.stringify(data.sys_feat));
