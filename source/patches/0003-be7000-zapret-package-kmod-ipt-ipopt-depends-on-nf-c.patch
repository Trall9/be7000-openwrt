+    checkUpdates: async function(ev)
+    {
+        this._action = 'checkUpdates';
+        this.setStage(1);
+        this.pkg_url = null;
+        this.appendLog(_('Checking for updates...'));
+        let cmd = [ fn_update_pkg_sh, '-c' ];  // check for updates
