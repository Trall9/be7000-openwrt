 ...alcomm-ppe-dev_fill_forward_path-ctx.patch | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)
 create mode 100644 target/linux/qualcommbe/patches-6.18/0599-net-ethernet-qualcomm-ppe-dev_fill_forward_path-ctx.patch

diff --git a/target/linux/qualcommbe/patches-6.18/0599-net-ethernet-qualcomm-ppe-dev_fill_forward_path-ctx.patch b/target/linux/qualcommbe/patches-6.18/0599-net-ethernet-qualcomm-ppe-dev_fill_forward_path-ctx.patch
new file mode 100644
index 00000000..43170d85
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0599-net-ethernet-qualcomm-ppe-dev_fill_forward_path-ctx.patch
@@ -0,0 +1,38 @@
+From: Trall9 <Trall9@users.noreply.github.com>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: use net_device_path_ctx for dev_fill_forward_path
+
+The 706-01 backport (Linux 7.3) changed dev_fill_forward_path() to take a
+struct net_device_path_ctx. Build the context at both call sites. The
+ieee80211 flag stays unset like in mtk_ppe and airoha: these lookups
+resolve the wired underlay of a PPPoE or tunnel device.
+
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+@@ -571,7 +571,12 @@
+ 	topo->vlan_mtu = ppp_dev->mtu;
+ 
+ 	rcu_read_lock();
+-	ret = dev_fill_forward_path(ppp_dev, daddr, &stack);
++	{
++		struct net_device_path_ctx ctx = { .dev = ppp_dev };
++
++		ether_addr_copy(ctx.daddr, daddr);
++		ret = dev_fill_forward_path(&ctx, &stack);
++	}
+ 	if (ret)
+ 		goto out_unlock;
+ 
+@@ -1309,7 +1314,12 @@
+ 		goto out_dst;
+ 	}
+ 	rcu_read_lock();
+-	ret = dev_fill_forward_path(dst->dev, daddr, &stack);
++	{
++		struct net_device_path_ctx ctx = { .dev = dst->dev };
++
++		ether_addr_copy(ctx.daddr, daddr);
++		ret = dev_fill_forward_path(&ctx, &stack);
++	}
+ 	if (ret)
+ 		goto out_unlock;
+ 
