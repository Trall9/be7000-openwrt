+ 
++struct sk_buff *ath12k_dp_rx_alloc_skb(struct page_frag_cache *cache,
++				       unsigned int len)
++{
++	gfp_t gfp_mask = GFP_ATOMIC | __GFP_NOWARN;
++	struct sk_buff *skb;
++	void *data;
++
++	len += NET_SKB_PAD;
++	len = SKB_HEAD_ALIGN(len);
