--- a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-ram-guard
+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-ram-guard
@@ -5,11 +5,17 @@
 # только сигнал (убийство сервисов по решению владельца).
 AV=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
 ST=/tmp/ram-guard-state
+# топ-3 по RSS+swap из /proc (ps w пишет большие VSZ как «108m» — сортировка ломалась)
+top3() {
+	for p in /proc/[0-9]*; do
+		awk '/^Name:/{n=$2} /^VmRSS:/{r=$2} /^VmSwap:/{s=$2} END{if (r != "") print int((r+s)/1024), n}' $p/status 2>/dev/null
+	done | sort -rn | head -3 | awk '{printf "%sMB(%s) ", $1, $2}'
+}
 if [ "$AV" -lt 200 ]; then
 	NOW=$(date +%s)
 	LAST=$(cat $ST 2>/dev/null); [ -n "$LAST" ] || LAST=0
 	if [ $((NOW - LAST)) -ge 1800 ]; then
-		logger -t ram-guard "ALERT: available ${AV}MB < 200MB; топ по VSZ: $(ps w | awk 'NR>1{print $3, $6}' | sort -rn | head -3 | awk '{printf "%sKB(%s) ", $1, $2}')"
+		logger -t ram-guard "ALERT: available ${AV}MB < 200MB; топ по RSS+swap: $(top3)"
 		echo $NOW > $ST
 	fi
 	exit 0
