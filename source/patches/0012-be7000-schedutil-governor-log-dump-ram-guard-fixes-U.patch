 #!/bin/sh
 # Персистентный лог: дамп logread в /mnt/sda1/logs/ (кольцо logd живёт в RAM и
-# умирает при ребуте — постмортемы были недиагностируемы). Дедуп через первую
-# строку кольца (детект wrap), ротация 5МБ. Нет диска — тихо выходим
-# (usb-watchdog вернёт диск, со следующим тиком дамп продолжится).
+# умирает при ребуте — постмортемы были недиагностируемы). Дедуп по последней
+# записанной строке: ищем её в текущем кольце и дописываем только то, что после.
+# Не нашли (ребут / кольцо провернулось дальше) — полный дамп с маркером.
+# Ротация 5МБ. Нет диска — тихо выходим (usb-watchdog вернёт диск, со
+# следующим тиком дамп продолжится).
 LOGDIR=/mnt/sda1/logs
 CUR=$LOGDIR/router-current.log
 PREV=$LOGDIR/router-prev.log
-F=/tmp/log-dump-first
-CNT=/tmp/log-dump-count
+L=/tmp/log-dump-last
+SNAP=/tmp/log-dump-snap
 
 mount | grep -qs " /mnt/sda1 " || exit 0
 mkdir -p "$LOGDIR" || exit 0
 
-FIRST=$(logread 2>/dev/null | head -n 1)
-TOTAL=$(logread 2>/dev/null | wc -l)
-[ -n "$FIRST" ] || exit 0
-OLD_FIRST=$(cat $F 2>/dev/null)
-OLD_N=$(cat $CNT 2>/dev/null); [ -n "$OLD_N" ] || OLD_N=0
+logread > $SNAP 2>/dev/null
+LAST=$(tail -n 1 $SNAP)
+[ -n "$LAST" ] || { rm -f $SNAP; exit 0; }
+OLD_LAST=$(cat $L 2>/dev/null)
 
-if [ "$FIRST" = "$OLD_FIRST" ] && [ "$TOTAL" -gt "$OLD_N" ]; then
-	# обычный случай: кольцо стоит на месте, дописываем только новых
