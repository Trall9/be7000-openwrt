 }
 
+usb_phy_reset() {
+	local P=/sys/bus/platform/drivers
+	echo 8af8800.usb > $P/dwc3-qcom-legacy/unbind 2>/dev/null
+	echo 7b000.usb-phy > $P/qcom-qusb2-phy/unbind 2>/dev/null
+	echo 7d000.usb-phy > $P/qcom-qmp-usb-phy/unbind 2>/dev/null
+	sleep 5
+	echo 7b000.usb-phy > $P/qcom-qusb2-phy/bind 2>/dev/null
+	echo 7d000.usb-phy > $P/qcom-qmp-usb-phy/bind 2>/dev/null
+	sleep 1
+	echo 8af8800.usb > $P/dwc3-qcom-legacy/bind 2>/dev/null
+}
+
 no_disk() {
 	local N V now last x
 	[ -e "$SEEN" ] || exit 0
@@ -85,35 +102,118 @@ no_disk() {
 		echo $((V+1)) > $VCNT
 		exit 0
 	fi
+	# PHY завис после холодного старта: xHCI rebind не помогает, порт не видит
+	# даже перетык кабеля. Полный сброс dwc3 + обоих PHY (17.10) — после него
+	# перетык работает. Док, уже воткнутый в момент сброса, не переподключается.
+	if [ ! -e "$PCNT" ]; then
+		logger -t usb-watchdog "сброс dwc3 + USB PHY (после него перетык кабеля сработает)"
+		usb_phy_reset
+		echo 1 > $PCNT
+		exit 0
+	fi
 	now=$(date +%s); last=$(cat $ALERT 2>/dev/null); [ -n "$last" ] || last=0
 	if [ $((now-last)) -ge 600 ]; then
-		logger -t usb-watchdog "ALERT: USB-диск пропал и не вернулся после автоматических попыток. Переподключите диск или обесточьте его бокс на 30 сек. Если диск убран насовсем: rm $SEEN"
+		logger -t usb-watchdog "ALERT: USB-диск пропал и не вернулся после автоматических попыток. USB PHY уже сброшен — выньте и воткните USB-кабель дока в роутер. Если диск убран насовсем: rm $SEEN"
 		echo $now > $ALERT
