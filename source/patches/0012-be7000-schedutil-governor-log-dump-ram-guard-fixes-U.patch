+# мёртвый маунт: нет source-ноды или ext4 в shutdown после I/O-ошибок
+# (нода могла появиться снова под тем же именем). /opt — bind с ext4-раздела.
+dead_mount() {
+	local src mp fs opts rest
+	grep '^/dev/sd' /proc/mounts | while read src mp fs opts rest; do
+		case "$mp" in /mnt/*|/opt) ;; *) continue ;; esac
+		case ",$opts," in *,shutdown,*) echo "$src $mp"; break ;; esac
+		[ -b "$src" ] || { echo "$src $mp"; break; }
+	done
+}
+umount_dead() {
+	local M
+	while M=$(dead_mount) && [ -n "$M" ]; do
+		set -- $M
+		logger -t usb-watchdog "мёртвый маунт $1 на $2 — снимаю (lazy)"
+		# /mnt/sda1, ext4-раздел приложений (DISK_MP из /etc/opt-install.conf), /opt
+		case "$2" in /mnt/sda1|"$OPT_DISK"|/opt) stop_disk_services ;; esac
+		umount -l "$2" 2>/dev/null
+		grep -q "^$1 $2 " /proc/mounts && break
+	done
+}
+
+# ---------- режимы из hotplug ----------
+# lost   — диск только что пропал: сразу глушим приложения (иначе пишут в мёртвый
+#          том; block hotplug перемонтирует раздел за секунды, и плановый проход
+#          мёртвого маунта уже не видит), снимаем мёртвые маунты, затем каждые
+#          LOST_STEP_SEC — обычный цикл (rebind/VBUS), пока диск не вернётся.
+# hangwatch — служба: зависание моста без remove-события → снять диск (→ lost).
+# settle — появился раздел: ждём, пока block/30-usb-disk-mount смонтирует все
+#          разделы, и делаем обычный цикл (канонизация, samba, автозапуск).
+LOST_STEP_SEC=15
+LOCK=/var/lock/usb-watchdog.lock
+case "$1" in
+lost)
+	exec 7>/var/lock/usb-wd-lost.lock
+	flock -n 7 || exit 0
+	exec 8>$LOCK
+	flock 8 || exit 0
+	logger -t usb-watchdog "диск отключился — останавливаю приложения"
+	stop_disk_services
+	umount_dead
+	flock -u 8
+	n=0
+	while [ $n -lt $((RETRY_REBIND + RETRY_VBUS + 1)) ]; do
+		sleep $LOST_STEP_SEC
+		ls /dev/sd[a-z] >/dev/null 2>&1 && break
+		/usr/bin/usb-watchdog.sh
+		n=$((n+1))
+	done
+	# диск вернулся быстро (событие add могло прийти, пока приложения ещё
+	# останавливались) — подъём сервисов здесь же
+	exec 7>&-
+	ls /dev/sd[a-z] >/dev/null 2>&1 && exec /usr/bin/usb-watchdog.sh
+	exit 0 ;;
+hangwatch)
+	# служба /etc/init.d/usb-hangwatch. Мост RTL9210B может зависнуть, не пропав
+	# с шины: UAS-команды висят, reset не проходит, sdX остаётся, remove-события
+	# нет. По этим строкам ядра снимаем диск сами — дальше обычный путь lost.
+	# logread -e понимает только базовый regex — фильтр в case
+	logread -f | while read -r l; do
+		case "$l" in
+		*"uas_eh_device_reset_handler FAILED"*|*-port[0-9]*": Cannot enable"*) ;;
+		*) continue ;;
+		esac
+		now=$(date +%s)
+		[ $((now - ${last:-0})) -ge 60 ] || continue
+		for d in /sys/block/sd[a-z]; do
+			[ -e "$d/device/delete" ] || continue
+			case "$(readlink -f $d)" in */usb[0-9]*) ;; *) continue ;; esac
+			last=$now
+			logger -t usb-watchdog "мост завис (${l##*kernel: }) — снимаю ${d##*/}"
+			echo 1 > $d/device/delete
+		done
+	done
+	exit 0 ;;
+settle)
+	exec 7>/var/lock/usb-wd-settle.lock
+	flock -n 7 || exit 0
+	sleep 8
+	exec 7>&-
+	exec /usr/bin/usb-watchdog.sh ;;
+esac
+
+exec 8>$LOCK
+flock 8 || exit 0
+
