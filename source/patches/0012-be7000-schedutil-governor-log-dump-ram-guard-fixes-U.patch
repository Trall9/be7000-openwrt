-elif [ "$FIRST" != "$OLD_FIRST" ]; then
-	# ребут (или редкое совпадение) / кольцо провернулось — полный дамп с маркером
-	echo "=== кольцо провернулось/ребут $(date '+%d.%m %H:%M:%S'), полный дамп ($TOTAL строк) ===" >> $CUR
-	logread >> $CUR
+N=
+[ -n "$OLD_LAST" ] && N=$(grep -nxF -- "$OLD_LAST" $SNAP | tail -n 1 | cut -d: -f1)
+if [ -n "$N" ]; then
+	# обычный случай: дописываем только новые строки после прошлой последней
+	tail -n +$((N + 1)) $SNAP >> $CUR
+else
+	echo "=== ребут/потеря стыка $(date '+%d.%m %H:%M:%S'), полный дамп ($(wc -l < $SNAP) строк) ===" >> $CUR
+	cat $SNAP >> $CUR
 fi
-echo "$FIRST" > $F
-echo "$TOTAL" > $CNT
