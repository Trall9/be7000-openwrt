++	u64_stats_add(&stats->tx_bytes, tx_bytes);
++	u64_stats_add(&stats->tx_packets, tx_packets);
++	u64_stats_update_end(&stats->syncp);
++
++	rcu_read_unlock();
++	return 0;
++}
