++		napi_wgt = NSS_EMPTY_BUFFER_RETURN_PROCESSING_WEIGHT;
++		cause = NSS_N2H_INTR_EMPTY_BUFFER_QUEUE;
++		irq_name = NSS_IRQ_NAME_EMPTY_BUF_QUEUE;
