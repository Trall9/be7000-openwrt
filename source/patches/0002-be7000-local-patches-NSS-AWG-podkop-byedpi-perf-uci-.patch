diff --git a/package/byedpi/files/etc/init.d/byedpi b/package/byedpi/files/etc/init.d/byedpi
new file mode 100644
index 00000000..2899279d
--- /dev/null
+++ b/package/byedpi/files/etc/init.d/byedpi
@@ -0,0 +1,26 @@
+#!/bin/sh /etc/rc.common
+# byedpi (ciadpi) init script
+USE_PROCD=1
+START=99
+STOP=10
+
+start_service() {
+	local enabled ip port extra
+	config_load byedpi
+	config_get_bool enabled main enabled 0
+	[ "$enabled" = "1" ] || return 0
+	config_get ip main ip "127.0.0.1"
+	config_get port main port "1080"
+	config_get extra main extra_args ""
+
+	procd_open_instance
+	procd_set_param command /usr/bin/ciadpi --ip "$ip" --port "$port" $extra
+	procd_set_param respawn 3600 5 0
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
+
+service_triggers() {
+	procd_add_reload_trigger "byedpi"
+}
