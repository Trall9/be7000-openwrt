+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-config-backup
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Ночной бэкап конфига: sysupgrade -b (весь /etc/config + overlay-правки) на диск.
+# Храним последние 7. Нет диска — тихо выходим.
+B=/mnt/sda1/backups
+mount | grep -qs " /mnt/sda1 " || exit 0
+mkdir -p "$B" || exit 0
+F=$B/config-$(date +%Y%m%d).tar.gz
+sysupgrade -b $F.tmp 2>/dev/null && mv -f $F.tmp $F || { rm -f $F.tmp; exit 1; }
+ls -1t $B/config-*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm -f
+logger -t config-backup "готово: $F ($(du -h $F | cut -f1))"
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-crashlog b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-crashlog
new file mode 100755
index 00000000..e9bac6d2
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-crashlog
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Постмортем паник: стоковая NAND-партиция "crash" (mtd25), mtdoops пишет туда
+# kmsg при panic (cmdline: mtdoops.mtddev=25, panic=15 → ребут через 15с).
+# be7000-crashlog        — последние ~80 строк из партиции
+# be7000-crashlog raw    — сырой дамп (для сохранения на ПК)
+# be7000-crashlog clear  — пометить: читать заново (пометка в /tmp; NAND mtdoops кольцевой)
+D=/dev/mtd25ro
+[ -c "$D" ] || { echo "нет $D (партиция crash)"; exit 1; }
+case "$1" in
+raw)
+	dd if=$D bs=4096 2>/dev/null | strings | tail -200
+	;;
+clear)
+	touch /tmp/crashlog-seen-$(date +%s)
+	echo "постмортем просмотрен (кольцевой буфер в NAND перезапишется сам)"
+	;;
+*)
+	echo "--- mtd25 (crash), читаемые строки: ---"
+	dd if=$D bs=4096 2>/dev/null | strings | grep -v "^*$" | tail -80
+	echo "--- конец (пусто = паник с прошлой прошивки не было) ---"
+	;;
+esac
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-health-check b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-health-check
new file mode 100755
index 00000000..4daa17ce
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-health-check
@@ -0,0 +1,66 @@
+#!/bin/sh
+# be7000-health-check — полный осмотр после прошивки/сбоя: wifi 7/7 + живучесть.
+# Одна команда «всё ли живо». Пункт [FAIL] = лезть в ЖУРНАЛ_ЭКСПЕРИМЕНТОВ.md.
+echo "=== be7000-health-check $(date '+%d.%m.%Y %H:%M') ==="
+
+# --- WiFi (канонический чек) ---
+WC=/sbin/be7000-wifi-check
+[ -x $WC ] || WC=/usr/bin/be7000-wifi-check
+[ -x $WC ] && $WC || echo "[FAIL] be7000-wifi-check не найден"
+
+# --- аппаратный watchdog (hang ядра = перезагрузка, а не кирпич) ---
+W=$(cat /sys/class/watchdog/watchdog0/state 2>/dev/null)
+[ "$W" = "active" ] && echo "[OK] hw watchdog qcom_wdt active" || echo "[FAIL] watchdog state=${W:-нет}!"
+
+# --- канал постмортема (mtdoops → NAND "crash") ---
+grep -qs "mtdoops.mtddev=25" /proc/cmdline && echo "[OK] mtdoops -> mtd25 (be7000-crashlog после паники)" || echo "[WARN] mtdoops нет в cmdline (старый образ)"
+
+# --- диск ---
+if mount | grep -qs " /mnt/sda1 "; then
+	echo "[OK] диск /mnt/sda1 смонтирован ($(df -h /mnt/sda1 | awk 'NR==2{print $4" свободно"}'))"
+else
+	echo "[WARN] диск НЕ смонтирован — usb-watchdog лечит rebind'ами; клин = обесточить бокс 30с"
+fi
+
+# --- cron-джобы живучести ---
+CR=/etc/crontabs/root
+for j in usb-watchdog.sh be7000-log-dump be7000-ram-guard be7000-config-backup; do
+	grep -qs "$j" $CR && echo "[OK] cron $j" || echo "[WARN] cron $j отсутствует"
+done
+
+# --- персистентный лог ---
+if [ -s /mnt/sda1/logs/router-current.log ]; then
+	echo "[OK] персистентный лог: $(du -h /mnt/sda1/logs/router-current.log | cut -f1) (+prev: $([ -f /mnt/sda1/logs/router-prev.log ] && du -h /mnt/sda1/logs/router-prev.log | cut -f1 || echo нет))"
+else
+	echo "[WARN] персистентный лог пуст (диска нет или первый тик)"
+fi
+
+# --- RAM ---
+AV=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
+[ "$AV" -ge 200 ] && echo "[OK] RAM available ${AV}МБ" || echo "[ALERT] RAM available ${AV}МБ < 200 — смотреть ram-guard ALERT в logread"
+Z=$(awk '/MemAvailable/{print $2}' /proc/meminfo); SW=$(free | awk '/Mem:/{print $3}')
+echo "[INFO] RAM used ${SW}КБ из 900252КБ"
+
+# --- температуры ---
+T=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
+[ -n "$T" ] && { TT=$((T/1000)); [ "$TT" -lt 80 ] && echo "[OK] SoC ${TT}°C" || echo "[ALERT] SoC ${TT}°C >= 80 — проверить throttling"; }
+
+# --- usb autosuspend ---
+AS=$(cat /sys/module/usbcore/parameters/autosuspend 2>/dev/null)
+[ "$AS" = "-1" ] && echo "[OK] usb autosuspend=-1" || echo "[FAIL] usb autosuspend=$AS (должно быть -1 из cmdline/DTS)"
+
+# --- apk-фиды ---
+if grep -qs aarch64_generic /etc/apk/repositories.d/distfeeds.list && grep -qx aarch64_generic /etc/apk/arch; then echo "[OK] apk arch aarch64_generic (фиды + /etc/apk/arch)"; else echo "[FAIL] apk: фиды или /etc/apk/arch без aarch64_generic — apk add не работает (см. 22_be7000_persist)"; fi
+
+# --- сервисы ---
+for s in samba4; do
+	[ -x /etc/init.d/$s ] && { /etc/init.d/$s running >/dev/null 2>&1 && echo "[OK] $s running" || echo "[WARN] $s enabled но не running"; }
+done
+DISK_SV="qbittorrent xray tailscale dockerd"
+if mount | grep -qs " /mnt/sda1 "; then
+	for s in $DISK_SV; do
+		[ -x /etc/init.d/$s ] && { /etc/init.d/$s running >/dev/null 2>&1 && echo "[OK] $s running" || echo "[WARN] $s не running (переустановить через opt-install?)"; }
+	done
+fi
+
+echo "=== конец проверки ==="
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-log-dump b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-log-dump
new file mode 100755
index 00000000..230347a2
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-log-dump
@@ -0,0 +1,36 @@
+#!/bin/sh
+# Персистентный лог: дамп logread в /mnt/sda1/logs/ (кольцо logd живёт в RAM и
+# умирает при ребуте — постмортемы были недиагностируемы). Дедуп через первую
+# строку кольца (детект wrap), ротация 5МБ. Нет диска — тихо выходим
+# (usb-watchdog вернёт диск, со следующим тиком дамп продолжится).
+LOGDIR=/mnt/sda1/logs
+CUR=$LOGDIR/router-current.log
+PREV=$LOGDIR/router-prev.log
+F=/tmp/log-dump-first
+CNT=/tmp/log-dump-count
+
+mount | grep -qs " /mnt/sda1 " || exit 0
+mkdir -p "$LOGDIR" || exit 0
+
+FIRST=$(logread 2>/dev/null | head -n 1)
+TOTAL=$(logread 2>/dev/null | wc -l)
+[ -n "$FIRST" ] || exit 0
+OLD_FIRST=$(cat $F 2>/dev/null)
+OLD_N=$(cat $CNT 2>/dev/null); [ -n "$OLD_N" ] || OLD_N=0
+
+if [ "$FIRST" = "$OLD_FIRST" ] && [ "$TOTAL" -gt "$OLD_N" ]; then
+	# обычный случай: кольцо стоит на месте, дописываем только новых
+	logread | tail -n $((TOTAL - OLD_N)) >> $CUR
+elif [ "$FIRST" != "$OLD_FIRST" ]; then
+	# ребут (или редкое совпадение) / кольцо провернулось — полный дамп с маркером
+	echo "=== кольцо провернулось/ребут $(date '+%d.%m %H:%M:%S'), полный дамп ($TOTAL строк) ===" >> $CUR
+	logread >> $CUR
+fi
+echo "$FIRST" > $F
+echo "$TOTAL" > $CNT
+
+# ротация: 5МБ → current становится prev
+if [ -f $CUR ] && [ "$(wc -c < $CUR)" -gt 5242880 ]; then
+	mv -f $CUR $PREV
+	echo "=== ротация $(date '+%d.%m %Y') ===" > $CUR
+fi
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-ram-guard b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-ram-guard
new file mode 100755
index 00000000..907a6895
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-ram-guard
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Страж RAM: ALERT в лог при available < 200МБ (не чаще раза в 30 мин).
+# Jackett ~120-250МБ + Docker + qbt при 900МБ total — надо видеть голод заранее,
+# пока zram (449МБ) не начал свопить и всё не затормозило. Автодействий НЕТ —
+# только сигнал (убийство сервисов по решению владельца).
+AV=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
+ST=/tmp/ram-guard-state
+if [ "$AV" -lt 200 ]; then
+	NOW=$(date +%s)
+	LAST=$(cat $ST 2>/dev/null); [ -n "$LAST" ] || LAST=0
+	if [ $((NOW - LAST)) -ge 1800 ]; then
+		logger -t ram-guard "ALERT: available ${AV}MB < 200MB; топ по VSZ: $(ps w | awk 'NR>1{print $3, $6}' | sort -rn | head -3 | awk '{printf "%sKB(%s) ", $1, $2}')"
+		echo $NOW > $ST
+	fi
+	exit 0
+fi
+rm -f $ST
