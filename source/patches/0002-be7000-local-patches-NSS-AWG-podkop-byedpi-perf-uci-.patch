+-			nss_bridge_mgr_warn("%px: Failed to remove slave (%s) state in Bridge %s\n", b_pvt,
+-					cu_info->upper_dev->name, master->name);
+-		}
+-	}
+-
+-	return NOTIFY_DONE;
+-}
