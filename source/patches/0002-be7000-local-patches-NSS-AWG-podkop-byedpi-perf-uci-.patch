+	done
+	if [ "$configured" = 0 ]; then
+		uci -q batch <<-EOF
+			set wireless.radio0.disabled='0'
+			set wireless.radio1.disabled='0'
+			set wireless.default_radio0.disabled='0'
+			set wireless.default_radio1.disabled='0'
+			set wireless.default_radio0.encryption='psk2'
+			set wireless.default_radio0.key='be7000setup'
+			set wireless.default_radio1.encryption='sae-mixed'
+			set wireless.default_radio1.key='be7000setup'
+		EOF
+	fi
+
+	# U-APSD off на обеих точках (см. 18_be7000_uapsd_off: провалы аплинка у
+	# Windows-клиентов). uci-defaults 18 срабатывает при первой загрузке раньше,
+	# чем ath12k создаёт radio1, и 5 ГГц оставался с U-APSD — дублируем здесь,
+	# где оба радио уже гарантированно есть.
+	uci -q set wireless.default_radio0.uapsd_advertisement_enabled='0'
+	uci -q set wireless.default_radio1.uapsd_advertisement_enabled='0'
+	# 802.11k/v (23_be7000_roaming) — по той же причине; только с полным wpad,
+	# на wpad-basic опция bss_transition роняет обе точки (инцидент 27.09).
+	if grep -qs "^P:wpad-mbedtls$\|^P:wpad-openssl$\|^P:wpad-wolfssl$" /lib/apk/db/installed; then
+		for r in 0 1; do
+			uci -q set wireless.default_radio$r.bss_transition='1'
+			uci -q set wireless.default_radio$r.ieee80211k='1'
+		done
+	fi
+
 	if [ -n "$country" ]; then
 		uci -q set wireless.radio0.country="$country"
 		uci -q set wireless.radio1.country="$country"
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-config-backup b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/be7000-config-backup
