diff --git a/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/usb-watchdog.sh b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/usb-watchdog.sh
new file mode 100755
index 00000000..681a626c
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/usr/bin/usb-watchdog.sh
@@ -0,0 +1,191 @@
+#!/bin/sh
+# USB watchdog v6 (30.09.2026) — само-восстановление USB-диска. Cron: каждую минуту.
+# Лог: logger -t usb-watchdog. Настройки (необязательно): /etc/usb-watchdog.conf
+#
+# Эскалация при пропаже диска работает, только если диск на этом роутере уже
+# был смонтирован (маркер /etc/usb-watchdog.seen) — без диска скрипт молчит.
+#
+# Ступени, когда sd* пропал:
+#  A) xHCI rebind ×RETRY_REBIND — лечит glitch хаб-цепочки после холодного старта
+#  B) VBUS power cycle порта хаба ×RETRY_VBUS (usbportctl) — только если в
+#     /etc/usb-watchdog.conf заданы HUB_BUS/HUB_DEV/HUB_PORT (хаб с
+#     individual port power switching); лечит лёгкий клин USB-моста
+#  C) ALERT каждые 10 мин — «переподключите диск / обесточьте бокс на 30 с»
+#
+# Когда sd* есть:
+#  1) мёртвые маунты (нет dev-ноды) — umount -l;
+#  2) канонизация: NTFS-раздел монтируется НАПРЯМУЮ в /mnt/sda1 (samba,
+#     opt-install); иной первый раздел — обычным mount, если его никто не поднял;
+#  3) проба записи: смонтирован, но запись даёт ошибку (грязный NTFS после
+#     аварийного отключения) — перемонтирование с очисткой dirty;
+#  4) подъём samba и приложений opt-install с включённым автозапуском.
+#
+# NTFS dirty: чистый mount → scanvol clear → чистый → force.
+
+RETRY_REBIND=3
+RETRY_VBUS=2
+VBUS_OFF_SEC=12
+HUB_BUS=
+HUB_DEV=
+HUB_PORT=
+[ -r /etc/usb-watchdog.conf ] && . /etc/usb-watchdog.conf
+
+SEEN=/etc/usb-watchdog.seen
+CNT=/tmp/usb-wd-count
+VCNT=/tmp/usb-wd-vcnt
+ALERT=/tmp/usb-wd-alert
+AUTOSTARTED=/tmp/usb-wd-autostarted  # приложения поднимаем один раз на каждое монтирование
+# сервисы, держащие файлы на диске: глушим перед перемонтированием
+DISK_SERVICES="jackett dockerd qbittorrent xray tailscale minidlna samba4"
+
+is_ntfs() { [ "$(dd if=$1 bs=1 skip=3 count=8 2>/dev/null)" = "NTFS    " ]; }
+
+mount_ntfs() { # $1=dev $2=mp
+	mount -t ntfs3 -o rw,uid=0,gid=0,umask=000 $1 $2 2>/dev/null && return 0
+	/usr/bin/scanvol $1 clear >/dev/null 2>&1
+	mount -t ntfs3 -o rw,uid=0,gid=0,umask=000 $1 $2 2>/dev/null && return 0
+	mount -t ntfs3 -o force,rw,uid=0,gid=0,umask=000 $1 $2 2>/dev/null
+}
+
+stop_disk_services() {
+	local s l
+	rm -f $AUTOSTARTED
+	for s in $DISK_SERVICES; do
+		[ -x /etc/init.d/$s ] && /etc/init.d/$s stop >/dev/null 2>&1
+	done
+	# ext4-том /opt (loop-файл на диске, см. opt-install)
+	if grep -q ' /opt ' /proc/mounts; then
+		umount /opt 2>/dev/null || umount -l /opt 2>/dev/null
+	fi
+	for l in $(losetup -a 2>/dev/null | grep 'ext4store.img' | cut -d: -f1); do
+		losetup -d $l 2>/dev/null
+	done
+}
+
+no_disk() {
+	local N V now last x
+	[ -e "$SEEN" ] || exit 0
+	N=$(cat $CNT 2>/dev/null); [ -n "$N" ] || N=0
+	if [ "$N" -lt "$RETRY_REBIND" ]; then
+		logger -t usb-watchdog "нет sd* — xHCI rebind $((N+1))/$RETRY_REBIND"
+		for x in /sys/bus/platform/drivers/xhci-hcd/xhci-hcd.*; do
+			[ -e "$x" ] || continue
+			x=${x##*/}
+			echo $x > /sys/bus/platform/drivers/xhci-hcd/unbind 2>/dev/null
+			sleep 3
+			echo $x > /sys/bus/platform/drivers/xhci-hcd/bind 2>/dev/null
+		done
+		echo $((N+1)) > $CNT
+		exit 0
+	fi
+	V=$(cat $VCNT 2>/dev/null); [ -n "$V" ] || V=0
+	if [ -n "$HUB_PORT" ] && [ -x /usr/bin/usbportctl ] && [ "$V" -lt "$RETRY_VBUS" ]; then
+		logger -t usb-watchdog "rebind не помог — VBUS power cycle хаба $HUB_BUS/$HUB_DEV порта $HUB_PORT ($((V+1))/$RETRY_VBUS)"
+		/usr/bin/usbportctl $HUB_BUS $HUB_DEV $HUB_PORT $VBUS_OFF_SEC >/dev/null 2>&1
+		echo $((V+1)) > $VCNT
+		exit 0
+	fi
+	now=$(date +%s); last=$(cat $ALERT 2>/dev/null); [ -n "$last" ] || last=0
+	if [ $((now-last)) -ge 600 ]; then
+		logger -t usb-watchdog "ALERT: USB-диск пропал и не вернулся после автоматических попыток. Переподключите диск или обесточьте его бокс на 30 сек. Если диск убран насовсем: rm $SEEN"
+		echo $now > $ALERT
+	fi
+	exit 0
+}
+
+# ---------- нет ни одного sd*? ----------
+if ! ls /dev/sd[a-z] >/dev/null 2>&1; then
+	no_disk
+fi
+
+rm -f $CNT $VCNT $ALERT
+
+# ---------- 1) мёртвые маунты: source-ноды не существует ----------
+dead_mount() {
+	local src mp rest
+	grep '^/dev/sd' /proc/mounts | while read src mp rest; do
+		case "$mp" in /mnt/*) ;; *) continue ;; esac
+		[ -b "$src" ] || { echo "$src $mp"; break; }
+	done
+}
+while M=$(dead_mount) && [ -n "$M" ]; do
+	set -- $M
+	logger -t usb-watchdog "мёртвый маунт $1 на $2 — снимаю (lazy)"
+	[ "$2" = /mnt/sda1 ] && stop_disk_services
+	umount -l "$2" 2>/dev/null || break
+done
+
+# ---------- 2) канонизация /mnt/sda1 ----------
+PART=""
+if [ -b /dev/sda1 ] && is_ntfs /dev/sda1; then
+	PART=/dev/sda1
+else
+	for d in /dev/sd[a-z]1; do
+		[ -b "$d" ] || continue
+		if is_ntfs "$d"; then PART=$d; break; fi
+	done
+fi
+
+CUR=$(grep ' /mnt/sda1 ' /proc/mounts | tail -n1 | awk '{print $1, $3}')
+CURSRC=$(echo $CUR | awk '{print $1}')
+CURFST=$(echo $CUR | awk '{print $2}')
+
+remount_part() {
+	local m
+	stop_disk_services
+	umount -l /mnt/sda1 2>/dev/null; umount -l /mnt/sda1 2>/dev/null
+	# если PART смонтирован под другой буквой — снимаем и его
+	for m in $(grep ' /mnt/sd[a-z][0-9] ' /proc/mounts | awk '{print $1"|"$2}'); do
+		[ "${m%%|*}" = "$PART" ] && umount -l "${m#*|}" 2>/dev/null
+	done
+	mkdir -p /mnt/sda1
+	if mount_ntfs $PART /mnt/sda1; then
+		logger -t usb-watchdog "восстановлено: $PART → /mnt/sda1"
+	else
+		logger -t usb-watchdog "ERR: не смог смонтировать $PART — попробую в следующий цикл"
+		exit 0
+	fi
+}
+
+if [ -n "$PART" ]; then
+	if [ "$CURFST" = "ntfs3" ] && [ "$CURSRC" = "$PART" ] && ls /mnt/sda1/ >/dev/null 2>&1; then
+		: # уже канонично
+	else
+		logger -t usb-watchdog "канонизация: $PART → /mnt/sda1 (сейчас: ${CURSRC:-ничего}/${CURFST:-—})"
+		remount_part
+	fi
+elif [ -z "$CUR" ] && [ -b /dev/sda1 ]; then
+	# не-NTFS диск (ext4/exFAT/…), который block-mount почему-то не поднял
+	mkdir -p /mnt/sda1
+	mount -o rw /dev/sda1 /mnt/sda1 2>/dev/null && logger -t usb-watchdog "смонтирован /dev/sda1 → /mnt/sda1"
+fi
+
+grep -q ' /mnt/sda1 ' /proc/mounts || exit 0
+
+# ---------- 3) проба записи ----------
+PROBE=/mnt/sda1/.usb-watchdog-probe.$$
+if ! { echo ok > $PROBE && rm -f $PROBE; } 2>/dev/null; then
+	if grep -q ' /mnt/sda1 [^ ]* ro[, ]' /proc/mounts; then
+		: # смонтирован только на чтение — не трогаем
+	elif [ -n "$PART" ]; then
+		logger -t usb-watchdog "запись на /mnt/sda1 даёт ошибку (грязный NTFS?) — перемонтирую $PART"
+		remount_part
+	else
+		logger -t usb-watchdog "запись на /mnt/sda1 даёт ошибку — проверьте диск"
+	fi
+fi
+
+[ -e "$SEEN" ] || touch "$SEEN"
+
+# ---------- 4) подъём сервисов ----------
+if ls /mnt/sda1/ >/dev/null 2>&1; then
+	if [ -x /etc/init.d/samba4 ] && /etc/init.d/samba4 enabled && ! pgrep smbd >/dev/null; then
+		/etc/init.d/samba4 start >/dev/null 2>&1 && logger -t usb-watchdog "samba4 запущена"
+	fi
+	# один раз после (пере)монтирования: «Стоп» из LuCI не перебиваем каждую минуту
+	if [ ! -e $AUTOSTARTED ] && [ -x /usr/bin/opt-install ]; then
+		touch $AUTOSTARTED
+		/usr/bin/opt-install autostart >/dev/null 2>&1
+	fi
+fi
+exit 0
