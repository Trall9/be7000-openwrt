diff --git a/target/linux/qualcommbe/ipq95xx/base-files/sbin/be7000-wifi-check b/target/linux/qualcommbe/ipq95xx/base-files/sbin/be7000-wifi-check
new file mode 100755
index 00000000..63ecfd29
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/sbin/be7000-wifi-check
@@ -0,0 +1,53 @@
+#!/bin/sh
+# BE7000: самопроверка Wi-Fi-фиксов 26.09 (потеря любого пункта = деградация скорости).
+# Зелёный статус каждого пункта обязателен. Запуск: be7000-wifi-check
+PASS=0; FAIL=0
+ok()   { echo "[ OK ] $1"; PASS=$((PASS+1)); }
+bad()  { echo "[FAIL] $1"; FAIL=$((FAIL+1)); }
+
+# 1. U-APSD выключен (иначе UL-провалы на Windows-клиентах)
+grep -q "^uapsd_advertisement_enabled=0" /var/run/hostapd-phy1.conf 2>/dev/null \
+	&& ok "U-APSD off (phy1)" || bad "U-APSD включён! uci set wireless.wifinet1.uapsd_advertisement_enabled='0'; wifi reload"
+
+# 2. AQL ОТКЛЮЧЕН (1M/1M): в backports 6.19 старые лимиты 60К/400К давали пилу скорости (просадки до 200М каждые ~10с). Пинг под нагрузкой без AQL: avg 4.4мс, 99.8% <50мс
+grep -q "^BE	1000000" /sys/kernel/debug/ieee80211/phy1/aql_txq_limit 2>/dev/null \
+	&& ok "AQL 1000000/1000000 (phy1)" || bad "AQL дефолты! rc.local-блок не отработал"
+
+# 3. CPU governor performance (иначе ядра спят на 936МГц)
+[ "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)" = "performance" ] \
+	&& ok "governor=performance" || bad "governor!=performance — проверь rc.local"
+
+# 4. Flow offload
+nft list flowtables 2>/dev/null | grep -q "flowtable" \
+	&& ok "flowtable активна" || bad "flowtable нет: uci set firewall.@defaults[0].flow_offloading='1'; /etc/init.d/firewall restart"
+
+# 5. RPS на wan (иначе однo-core форвардинг). f = ручной тюнинг 6.18;
+#    1 = дефолт/steering, на котором замерен финальный baseline 6.19 (DL 1.52/UL 1.61).
+r=$(cat /sys/class/net/wan/queues/rx-0/rps_cpus 2>/dev/null)
+case "$r" in
+	f) ok "RPS wan=f (ручной тюнинг)" ;;
+	1) ok "RPS wan=1 (дефолт steering, baseline 6.19)" ;;
+	*) bad "RPS wan=${r:-нет} — однo-core форвардинг, см. 21_be7000_net_perf" ;;
+esac
+
+# 6. packet_steering
+[ "$(uci -q get network.globals.packet_steering)" = "1" ] \
+	&& ok "packet_steering=1" || bad "steering off: uci set network.globals.packet_steering='1'"
+
+# 7. ath12k data IRQ не на CPU0 (MSI-номера плавают между бутами — ищем по имени,
+#    аффинити читаем из sysfs: mask 1 = CPU0 = плохо, 2/4/8 = ок)
+irq=$(grep -m1 "DP_EXT_IRQ" /proc/interrupts | cut -d: -f1)
+aff=$(cat /proc/irq/$irq/smp_affinity 2>/dev/null)
+case "$aff" in
+	1|"") bad "DP_EXT_IRQ (irq ${irq:-?}) affinity=${aff:-нет} — rc.local-блок не отработал" ;;
+	*) ok "ath12k IRQ разнесены (irq $irq → mask $aff)" ;;
+esac
+
+# 8. Справочно: speedbin фьюз (инфо, не ошибка)
+b=$(hexdump -v -s 21 -n 2 /sys/bus/nvmem/devices/qfprom0/nvmem 2>/dev/null | awk 'NR==1{gsub(/ /,""); print substr($0,5,2)$0}' >/dev/null 2>&1; dd if=/sys/bus/nvmem/devices/qfprom0/nvmem bs=1 skip=20 count=2 2>/dev/null | hexdump -v -e "/1 \"%02x\"" 2>/dev/null)
+echo "[INFO] speedbin raw(0x14..0x15): $b (ожидаемо 0080 = bin 1, потолок 1488МГц)"
+
+echo "-------------------------------------"
+echo "Итог: PASS=$PASS FAIL=$FAIL"
+[ "$FAIL" = "0" ] && echo "Wi-Fi-тюнинг полностью активен." || echo "Есть деградации — см. FAIL-строки."
+exit 0
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/sbin/be7000-wireless-defaults b/target/linux/qualcommbe/ipq95xx/base-files/sbin/be7000-wireless-defaults
