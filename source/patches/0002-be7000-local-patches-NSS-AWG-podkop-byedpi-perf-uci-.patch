diff --git a/package/qca-nss-drv/patches/0101-nss_data_plane-fix-rmmod-panic-on-double-unregister.patch b/package/qca-nss-drv/patches/0101-nss_data_plane-fix-rmmod-panic-on-double-unregister.patch
new file mode 100644
index 00000000..5a04c82f
--- /dev/null
+++ b/package/qca-nss-drv/patches/0101-nss_data_plane-fix-rmmod-panic-on-double-unregister.patch
@@ -0,0 +1,39 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] nss_data_plane: fix rmmod panic on double unregister
+
+__nss_data_plane_unregister() walks every core's subsys_dp table, but
+each physical interface is registered to ALL cores (exceptions can
+arrive from any core), so the per-interface unregister runs once per
+core. The first pass NULLs nss_data_plane_params[i].nss_ctx; the
+second pass hands that NULL to nss_data_plane_hal_unregister() ->
+nss_cmn_unregister_service_code(), which dereferences it:
+
+  Unable to handle kernel access ... at virtual address 00000000000021a8
+  pc : nss_cmn_unregister_service_code+0x4/0x24 [qca_nss_drv]
+  lr : nss_data_plane_hal_unregister+0x1c/0x34 [qca_nss_drv]
+
+Nobody noticed because the old ethernet stack autoloads qca-nss-drv
+and never removes it; with the data plane glue on the qca_edma stack,
+rmmod with attached ports is a supported operation. Unregister from
+nss-dp only on the first pass.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/nss_data_plane/nss_data_plane.c
++++ b/nss_data_plane/nss_data_plane.c
+@@ -347,7 +347,14 @@
+ 	for (core = 0; core < nss_top_main.num_nss; core++) {
+ 		for (i = NSS_DP_START_IFNUM; i < NSS_DP_MAX_INTERFACES; i++) {
+ 			if (nss_top_main.nss[core].subsys_dp_register[i].ndev) {
+-				nss_data_plane_unregister_from_nss_dp(i);
++				/*
++				 * The same interface is registered to every
++				 * core's subsys_dp table; unregister from
++				 * nss-dp only once or the second pass feeds
++				 * a NULLed nss_ctx to the hal unregister.
++				 */
++				if (nss_data_plane_params[i].nss_ctx)
++					nss_data_plane_unregister_from_nss_dp(i);
+ 				nss_core_unregister_subsys_dp(&nss_top_main.nss[core], i);
+ 			}
+ 		}
diff --git a/package/qca-nss-drv/patches/0102-nss_init-defer-probe-until-data-plane-armed.patch b/package/qca-nss-drv/patches/0102-nss_init-defer-probe-until-data-plane-armed.patch
new file mode 100644
index 00000000..121f7b02
--- /dev/null
+++ b/package/qca-nss-drv/patches/0102-nss_init-defer-probe-until-data-plane-armed.patch
@@ -0,0 +1,40 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] nss_init: defer probe until the data-plane glue is armed
+
+With ath11k NSS offload, ath11k.ko and mac80211.ko carry hard symbol
+references to qca-nss-drv, so kmodloader loads it at every boot. The
+probe boots the NSS firmware, and an unarmed firmware boot takes over
+all PPE CPU-port delivery (QID2RID rewrite, measured) and kills host
+ethernet RX. Defer to the qca-ppe-nss glue at the top of the probe:
+return -EPROBE_DEFER until at least one port is armed via fw_mask; the
+glue re-attaches the deferred core devices when arming happens.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+--- a/nss_init.c
++++ b/nss_init.c
+@@ -37,6 +37,7 @@
+ #include "nss_strings.h"
+ 
+ #include <nss_hal.h>
++#include <nss_dp_api_if.h>
+ 
+ #include <linux/module.h>
+ #include <linux/platform_device.h>
+@@ -116,6 +117,17 @@
+  */
+ static inline int nss_probe(struct platform_device *nss_dev)
+ {
++	int ret;
++
++	/*
++	 * Do not boot the NSS firmware until the data-plane glue has at
++	 * least one port armed; an unarmed firmware boot takes over all
++	 * PPE CPU-port delivery and kills host ethernet RX.
++	 */
++	ret = nss_dp_probe_gate(&nss_dev->dev);
++	if (ret)
++		return ret;
++
+ 	return nss_hal_probe(nss_dev);
+ }
+ 
diff --git a/package/qca-nss-drv/patches/0103-nss_core-fix-fraglist-skb-truesize-underaccounting.patch b/package/qca-nss-drv/patches/0103-nss_core-fix-fraglist-skb-truesize-underaccounting.patch
new file mode 100644
index 00000000..75584eb6
--- /dev/null
+++ b/package/qca-nss-drv/patches/0103-nss_core-fix-fraglist-skb-truesize-underaccounting.patch
@@ -0,0 +1,53 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] nss_core: fix fraglist skb truesize under-accounting
+
+When the firmware delivers a frame as a multi-segment chain (observed
+for virtually every full-MTU frame received through the wifili path),
+nss_core_handle_linear_skb() builds a fraglist skb but sets the head's
+truesize to desc->payload_len and grows it by desc->payload_len per
+appended segment. The result is truesize == exact wire frame length,
+which accounts for neither the two full-size receive buffers backing
+the chain nor the skb structures themselves.
+
+Before delivery, nss_core_handle_buffer_pkt() linearizes the fraglist
+for netdevs without NETIF_F_FRAGLIST (i.e. all of them). The second
+segment usually fits the head buffer's tailroom, so __skb_linearize()
+succeeds without reallocating the head and the bogus truesize survives
+into the network stack. Locally terminated TCP then trips
+
+  WARNING: ... net/core/skbuff.c:6200 skb_try_coalesce+0x4b8/0x504
+
+(WARN_ON_ONCE(delta < len), delta = truesize - SKB_DATA_ALIGN(sizeof
+(struct sk_buff))) on the first coalesced segment, and every chained
+frame under-accounts socket receive memory by roughly a full buffer.
+
+Keep the allocation-time truesize on the chain head and account each
+appended segment with its own full truesize, matching how the kernel
+itself accounts fraglists (e.g. IP defrag). Over-accounting after a
+later linearize is safe; under-accounting is what the WARN exists to
+catch.
+
+The paged/nr-frags path is already correct (it keeps the initial
+truesize and skb_add_rx_frag() adds PAGE_SIZE per segment) and is not
+touched.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+--- a/nss_core.c
++++ b/nss_core.c
+@@ -1361,7 +1361,6 @@
+ 
+ 		skb_frag_list_init(nbuf);
+ 		nbuf->data_len = 0;
+-		nbuf->truesize = desc->payload_len;
+ 		nbuf->priority = desc->pri;
+ 
+ #ifdef CONFIG_NET_CLS_ACT
+@@ -1421,7 +1420,7 @@
+ 	 */
+ 	head->data_len += desc->payload_len;
+ 	head->len += desc->payload_len;
+-	head->truesize += desc->payload_len;
++	head->truesize += nbuf->truesize;
+ 
+ 	if (!(bit_flags & N2H_BIT_FLAG_LAST_SEGMENT)) {
+ 		/*
diff --git a/package/qca-nss-drv/patches/0104-nss_shaper-add-the-11.4-per-node-stats-wire-format.patch b/package/qca-nss-drv/patches/0104-nss_shaper-add-the-11.4-per-node-stats-wire-format.patch
