+ 	 * Get the PPE base address
+ 	 */
+-	ppe_pvt.ppe_base = ioremap_nocache(PPE_BASE_ADDR, PPE_REG_SIZE);
++	ppe_pvt.ppe_base = nss_ioremap(PPE_BASE_ADDR, PPE_REG_SIZE);
+ 	if (!ppe_pvt.ppe_base) {
+ 		nss_warning("DRV can't get PPE base address\n");
+ 		return;
diff --git a/package/qca-nss-drv/patches/0002-nss-drv-add-support-for-kernel-5.15.patch b/package/qca-nss-drv/patches/0002-nss-drv-add-support-for-kernel-5.15.patch
