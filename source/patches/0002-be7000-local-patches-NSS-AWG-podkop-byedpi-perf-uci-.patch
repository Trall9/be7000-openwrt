diff --git a/package/qca-nss-clients/patches/0044-act_nssmirred-derive-igs-qos-tags-from-forward-chain-priority.patch b/package/qca-nss-clients/patches/0044-act_nssmirred-derive-igs-qos-tags-from-forward-chain-priority.patch
new file mode 100644
index 00000000..64f26c45
--- /dev/null
+++ b/package/qca-nss-clients/patches/0044-act_nssmirred-derive-igs-qos-tags-from-forward-chain-priority.patch
@@ -0,0 +1,113 @@
+act_nssmirred-derive-igs-qos-tags-from-forward-chain-priority
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/nss_qdisc/igs/nss_ifb.c
++++ b/nss_qdisc/igs/nss_ifb.c
+@@ -93,6 +93,64 @@ unsigned int nss_ifb_igs_ip_pre_routing_
+ }
+ 
+ /*
++ * nss_ifb_igs_ip_forward_hook()
++ *	Copy a firewall-assigned class-id to Linux CT structure.
++ *
++ * The pre-routing hook above runs before the mangle tables, so a class-id
++ * assigned by the firewall (e.g. an nftables 'meta priority set' statement
++ * in a mangle forward chain) is never visible to it. This hook runs right
++ * after mangle forward and copies the class-id major from skb->priority
++ * into the ingress QoS fields of the DSCP CT extension. Accelerated flows
++ * can therefore be steered into ingress (IFB) shaper bands with the same
++ * firewall statement that already steers the egress shaper, without any
++ * tc ingress filter.
++ *
++ * skb->priority itself is left untouched: the egress path still needs it.
++ */
++unsigned int nss_ifb_igs_ip_forward_hook(void *priv, struct sk_buff *skb,
++		 const struct nf_hook_state *state)
++{
++	struct nf_conn *ct;
++	struct nf_ct_dscpremark_ext *dscpcte;
++	enum ip_conntrack_info ctinfo;
++	uint16_t qostag;
++
++	if (unlikely(!skb))
++		return NF_ACCEPT;
++
++	/*
++	 * Return if no class-id major is set in the packet's priority.
++	 */
++	qostag = (uint16_t)(skb->priority >> 16);
++	if (likely(!qostag))
++		return NF_ACCEPT;
++
++	ct = nf_ct_get(skb, &ctinfo);
++	if (!ct)
++		return NF_ACCEPT;
++
++	spin_lock_bh(&ct->lock);
++	dscpcte = nf_ct_dscpremark_ext_find(ct);
++	if (!dscpcte) {
++		spin_unlock_bh(&ct->lock);
++		return NF_ACCEPT;
++	}
++
++	/*
++	 * Copy the class-id major to the ingress qostag field of the
++	 * packet's direction.
++	 */
++	if (IP_CT_DIR_ORIGINAL == CTINFO2DIR(ctinfo)) {
++		dscpcte->igs_flow_qos_tag = qostag;
++	} else {
++		dscpcte->igs_reply_qos_tag = qostag;
++	}
++	spin_unlock_bh(&ct->lock);
++
++	return NF_ACCEPT;
++}
++
++/*
+  * nss_ifb_list_del()
+  *	API to delete member in ifb list.
+  */
+--- a/nss_qdisc/igs/nss_ifb.h
++++ b/nss_qdisc/igs/nss_ifb.h
+@@ -51,6 +51,13 @@ extern unsigned int nss_ifb_igs_ip_pre_r
+ 		 const struct nf_hook_state *state);
+ 
+ /*
++ * nss_ifb_igs_ip_forward_hook()
++ * 	Forward hook function for IGS.
++ */
++extern unsigned int nss_ifb_igs_ip_forward_hook(void *priv, struct sk_buff *skb,
++		 const struct nf_hook_state *state);
++
++/*
+  * nss_ifb_list_del()
+  *	API to delete member in ifb list.
+  */
+--- a/nss_qdisc/igs/nss_mirred.c
++++ b/nss_qdisc/igs/nss_mirred.c
+@@ -679,6 +679,23 @@ struct nf_hook_ops nss_mirred_igs_nf_ops
+ 		.hooknum	=	NF_INET_PRE_ROUTING,
+ 		.priority	=	NF_IP_PRI_CONNTRACK + 1,
+ 	},
++
++	/*
++	 * Forward hook runs right after the mangle forward chain and copies
++	 * a firewall-assigned class-id (skb->priority) to the ECM rule.
++	 */
++	{
++		.hook		=	nss_ifb_igs_ip_forward_hook,
++		.pf		=	NFPROTO_IPV4,
++		.hooknum	=	NF_INET_FORWARD,
++		.priority	=	NF_IP_PRI_MANGLE + 1,
++	},
++	{
++		.hook		=	nss_ifb_igs_ip_forward_hook,
++		.pf		=	NFPROTO_IPV6,
++		.hooknum	=	NF_INET_FORWARD,
++		.priority	=	NF_IP_PRI_MANGLE + 1,
++	},
+ };
+ 
+ #if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 0))
diff --git a/package/qca-nss-clients/patches/0045-nss_qdisc-poll-per-node-statistics-on-the-11.4-firmware.patch b/package/qca-nss-clients/patches/0045-nss_qdisc-poll-per-node-statistics-on-the-11.4-firmware.patch
new file mode 100644
index 00000000..caa33ca4
--- /dev/null
+++ b/package/qca-nss-clients/patches/0045-nss_qdisc-poll-per-node-statistics-on-the-11.4-firmware.patch
@@ -0,0 +1,204 @@
+nss_qdisc-poll-per-node-statistics-on-the-11.4-firmware
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/nss_qdisc/nss_qdisc_stats.c
++++ b/nss_qdisc/nss_qdisc_stats.c
+@@ -19,6 +19,192 @@
+ 
+ #include "nss_qdisc.h"
+ 
++#ifdef NSS_FIRMWARE_VERSION_11_4
++/*
++ * The 11.4 firmware predates the stats-sync-many message: the same
++ * shaper-configure type is the per-node basic-stats request there, with a
++ * different payload. Poll every shaper node individually (the way the
++ * 11.4-era client did) and translate each response into the current
++ * response layout before handing it to the per-type stats callbacks.
++ */
++
++/*
++ * nss_qdisc_stats_basic_stats_callback()
++ *	Update one shaper node's statistics from a basic-stats response.
++ */
++static void nss_qdisc_stats_basic_stats_callback(void *app_data,
++				struct nss_if_msg *nim)
++{
++	struct nss_qdisc *nq = (struct nss_qdisc *)app_data;
++	struct Qdisc *qdisc = nq->qdisc;
++	struct nss_shaper_node_basic_stats_get *wire;
++	struct nss_shaper_node_stats_response response;
++	struct gnet_stats_basic_sync *bstats;
++	struct gnet_stats_queue *qstats;
++	refcount_t *refcnt;
++
++	if (nim->cm.response != NSS_CMN_RESPONSE_ACK) {
++		nss_qdisc_warning("Qdisc %px (type %d): receive stats FAILED - "
++				"response: type: %d\n", qdisc, nq->type,
++				nim->msg.shaper_configure.config.response_type);
++		atomic_sub(1, &nq->pending_stat_requests);
++		wake_up(&nq->wait_queue);
++		return;
++	}
++
++	/*
++	 * The 11.4 response has no leading qos_tag: rebuild the current
++	 * response layout so the per-type stats callbacks find their fields
++	 * at the offsets they expect.
++	 */
++	wire = &nim->msg.shaper_configure.config.msg.shaper_node_stats_get;
++	response.qos_tag = nq->qos_tag;
++	memcpy(&response.sn_stats, &wire->response.sn_stats,
++			sizeof(response.sn_stats));
++	memcpy(&response.per_sn_stats, &wire->response.per_sn_stats,
++			sizeof(response.per_sn_stats));
++
++	/*
++	 * Get the right stats pointers based on whether it is a class
++	 * or a qdisc.
++	 */
++	if (nq->is_class) {
++		bstats = &nq->bstats;
++		qstats = &nq->qstats;
++		refcnt = &nq->refcnt;
++	} else {
++		bstats = &qdisc->bstats;
++		qstats = &qdisc->qstats;
++		refcnt = &qdisc->refcnt;
++		qdisc->q.qlen = response.sn_stats.qlen_packets;
++	}
++
++	spin_lock_bh(&nq->lock);
++	u64_stats_add(&bstats->bytes, (__u64)response.sn_stats.delta.dequeued_bytes);
++	u64_stats_add(&bstats->packets, response.sn_stats.delta.dequeued_packets);
++	qstats->backlog = response.sn_stats.qlen_bytes;
++	qstats->drops += (response.sn_stats.delta.enqueued_packets_dropped +
++			response.sn_stats.delta.dequeued_packets_dropped);
++	qstats->qlen = response.sn_stats.qlen_packets;
++	qstats->requeues = 0;
++	qstats->overlimits += response.sn_stats.delta.queue_overrun;
++	spin_unlock_bh(&nq->lock);
++
++	/*
++	 * Shapers that maintain additional unique statistics process them
++	 * via their registered callback.
++	 */
++	if (nq->stats_cb) {
++		nq->stats_cb(nq, &response);
++	}
++
++	if (refcount_read(refcnt) == 0) {
++		atomic_sub(1, &nq->pending_stat_requests);
++		wake_up(&nq->wait_queue);
++		return;
++	}
++
++	/*
++	 * Request stats again in one second.
++	 */
++	nq->stats_get_timer.expires += HZ;
++	if (nq->stats_get_timer.expires <= jiffies) {
++		nq->stats_get_timer.expires = jiffies + HZ;
++	}
++	add_timer(&nq->stats_get_timer);
++}
++
++/*
++ * nss_qdisc_stats_get_timer_callback()
++ *	Send the periodic per-node stats request.
++ */
++static void nss_qdisc_stats_get_timer_callback(struct timer_list *tm)
++{
++	struct nss_qdisc *nq = timer_container_of(nq, tm, stats_get_timer);
++	nss_tx_status_t rc;
++	struct nss_if_msg nim;
++	int msg_type;
++
++	msg_type = nss_qdisc_get_interface_msg(nq->is_bridge, NSS_QDISC_IF_SHAPER_CONFIG);
++	nss_qdisc_msg_init(&nim, nq->nss_interface_number, msg_type,
++			sizeof(struct nss_if_shaper_configure),
++			nss_qdisc_stats_basic_stats_callback, nq);
++	nim.msg.shaper_configure.config.request_type = NSS_SHAPER_CONFIG_TYPE_SHAPER_NODE_BASIC_STATS_GET;
++	nim.msg.shaper_configure.config.msg.shaper_node_stats_get.qos_tag = nq->qos_tag;
++	rc = nss_if_tx_msg(nq->nss_shaping_ctx, &nim);
++	if (rc != NSS_TX_SUCCESS) {
++		/*
++		 * Retry in 100ms instead of a full second.
++		 */
++		nq->stats_get_timer.expires = jiffies + HZ / 10;
++		add_timer(&nq->stats_get_timer);
++	}
++}
++
++/*
++ * The work-queue/sync-many machinery does not exist on 11.4: the entry
++ * points the rest of the module calls become the per-node polling above.
++ */
++bool nss_qdisc_stats_work_queue_init(void)
++{
++	return true;
++}
++
++void nss_qdisc_stats_work_queue_exit(void)
++{
++}
++
++bool nss_qdisc_stats_sync_many_init(struct nss_qdisc *nq)
++{
++	return true;
++}
++
++void nss_qdisc_stats_sync_many_exit(struct nss_qdisc *nq)
++{
++}
++
++void nss_qdisc_stats_qdisc_attach(struct nss_qdisc *nq)
++{
++	if (atomic_read(&nq->pending_stat_requests)) {
++		return;
++	}
++
++	timer_setup(&nq->stats_get_timer, nss_qdisc_stats_get_timer_callback, 0);
++	nq->stats_get_timer.expires = jiffies + HZ;
++	atomic_set(&nq->pending_stat_requests, 1);
++	add_timer(&nq->stats_get_timer);
++}
++
++void nss_qdisc_stats_qdisc_detach(struct nss_qdisc *nq)
++{
++	if (timer_delete(&nq->stats_get_timer) > 0) {
++		/*
++		 * The timer had not fired: no response can be in flight.
++		 */
++		atomic_set(&nq->pending_stat_requests, 0);
++		return;
++	}
++
++	/*
++	 * The timer has fired: wait for the pending response to drain.
++	 */
++	if (!wait_event_timeout(nq->wait_queue,
++			atomic_read(&nq->pending_stat_requests) == 0,
++			NSS_QDISC_COMMAND_TIMEOUT)) {
++		nss_qdisc_error("Stats request command for %x timedout!\n", nq->qos_tag);
++	}
++}
++
++void nss_qdisc_stats_start_polling(struct nss_qdisc *nq)
++{
++}
++
++void nss_qdisc_stats_stop_polling(struct nss_qdisc *nq)
++{
++}
++
++#else /* !NSS_FIRMWARE_VERSION_11_4 */
++
+ static LIST_HEAD(nss_qdisc_stats_list);			/* List of stats request nodes */
+ static DEFINE_SPINLOCK(nss_qdisc_stats_list_lock);	/* Lock for the stats list */
+ static struct workqueue_struct *nss_qdisc_stats_workqueue;
+@@ -706,3 +892,4 @@ void nss_qdisc_stats_qdisc_detach(struct
+ 	nss_qdisc_htable_entry_del(&rnq->stats_wq->nqt, nq);
+ }
+ 
++#endif /* !NSS_FIRMWARE_VERSION_11_4 */
diff --git a/package/qca-nss-clients/patches/0046-vlan-mgr-drive-the-ppe-through-qca-ppe.patch b/package/qca-nss-clients/patches/0046-vlan-mgr-drive-the-ppe-through-qca-ppe.patch
new file mode 100644
index 00000000..6ef825e5
--- /dev/null
+++ b/package/qca-nss-clients/patches/0046-vlan-mgr-drive-the-ppe-through-qca-ppe.patch
@@ -0,0 +1,156 @@
+vlan-mgr: drive the PPE through qca-ppe and drop the QCA bonding paths
+
+The EDMA-rework tree has no ssdk, so the manager's fal-based PPE half
+cannot build - but the PPE side is not optional on IPQ807x: attaching
+a VSI to the firmware VLAN interface and programming the ingress
+translation and egress tagging is what makes the firmware treat the
+VLAN as a switching domain. Loading the manager with the PPE half
+compiled out (the ipq806x mode) brings core 0 down with a coredump
+the moment the first VLAN device registers. Replace it with the
+qca-ppe port VLAN helpers: qca-ppe allocates the VSI and owns every
+PPE table write, the manager attaches that VSI to the firmware VLAN
+interface and re-asserts the VSI masks after the attach (the firmware
+zeroes them, the same hazard the bridge manager handles). Only
+single-tagged 802.1Q uppers of physical ports are registered; double
+tags and 802.1ad bail out at create.
+
+The kernel also does not carry the QCA bonding hooks (bond_get_id,
+for_each_netdev_in_bond_rcu), so VLAN-over-LAG stays off and the two
+loops that used those hooks outside a BONDING_SUPPORT guard are
+brought under it, failing instance creation for bond masters.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/vlan/Makefile
++++ b/vlan/Makefile
+@@ -4,13 +4,7 @@ ccflags-y += -DNSS_CLIENT_BUILD_ID="$(BU
+ obj-m += qca-nss-vlan.o
+ qca-nss-vlan-objs := nss_vlan_mgr.o
+ 
+-ifeq ($(SoC),$(filter $(SoC),ipq807x ipq807x_64 ipq60xx ipq60xx_64))
+-ccflags-y += -DNSS_VLAN_MGR_PPE_SUPPORT
+-endif
++ccflags-y += -DNSS_VLAN_MGR_QCA_PPE
+ 
+ ccflags-y += -DNSS_VLAN_MGR_DEBUG_LEVEL=0
+ ccflags-y += -Wall -Werror
+-
+-ifneq (,$(filter $(CONFIG_BONDING),y m))
+-ccflags-y += -DBONDING_SUPPORT
+-endif
+--- a/vlan/nss_vlan_mgr.c
++++ b/vlan/nss_vlan_mgr.c
+@@ -27,6 +27,9 @@
+ #include <linux/sysctl.h>
+ #include <linux/module.h>
+ #include <net/bonding.h>
++#ifdef NSS_VLAN_MGR_QCA_PPE
++#include <linux/soc/qcom/qca_ppe.h>
++#endif
+ #include <nss_api_if.h>
+ #ifdef NSS_VLAN_MGR_PPE_SUPPORT
+ #include <ref/ref_vsi.h>
+@@ -113,6 +116,10 @@ struct nss_vlan_pvt {
+ 	int ifindex;				/* netdev ifindex */
+ 	int32_t port[NSS_VLAN_PHY_PORT_MAX];	/* real physical port of this vlan */
+ 	int32_t bond_ifnum;			/* bond interface number, if vlan is created over bond */
++#ifdef NSS_VLAN_MGR_QCA_PPE
++	struct net_device *qca_ppe_real_dev;
++	uint32_t qca_ppe_vsi;
++#endif
+ 	uint32_t vid;				/* vid info */
+ 	uint32_t tpid;				/* tpid info */
+ 	uint32_t mtu;				/* mtu info */
+@@ -751,6 +758,14 @@ static void nss_vlan_mgr_instance_free(s
+ 	}
+ #endif
+ 
++#ifdef NSS_VLAN_MGR_QCA_PPE
++	if (v->qca_ppe_real_dev) {
++		if (nss_vlan_tx_vsi_detach_msg(v->nss_if, v->qca_ppe_vsi))
++			nss_vlan_mgr_warn("%px: Failed to detach vsi %d\n", v, v->qca_ppe_vsi);
++		qca_ppe_port_vlan_vsi_put(v->qca_ppe_real_dev, v->vid);
++	}
++#endif
++
+ 	if (v->nss_if) {
+ 		nss_unregister_vlan_if(v->nss_if);
+ 		if (nss_dynamic_interface_dealloc_node(v->nss_if, NSS_DYNAMIC_INTERFACE_TYPE_VLAN) != NSS_TX_SUCCESS)
+@@ -850,6 +865,7 @@ static struct nss_vlan_pvt *nss_vlan_mgr
+ 				kfree(v);
+ 				return NULL;
+ 			}
++#if defined(BONDING_SUPPORT)
+ 			rcu_read_lock();
+ 			for_each_netdev_in_bond_rcu(real_dev, slave) {
+ 				port = nss_cmn_get_interface_number_by_dev(slave);
+@@ -863,6 +879,7 @@ static struct nss_vlan_pvt *nss_vlan_mgr
+ 			}
+ 			rcu_read_unlock();
+ 			v->bond_ifnum = bondid + NSS_LAG0_INTERFACE_NUM;
++#endif
+ 		}
+ 	} else if (!v->parent->parent) {
+ 		if (is_vlan_dev(real_dev)) {
+@@ -872,6 +889,7 @@ static struct nss_vlan_pvt *nss_vlan_mgr
+ 		if (!netif_is_bond_master(real_dev)) {
+ 			v->port[0] = v->parent->port[0];
+ 		} else {
++#if defined(BONDING_SUPPORT)
+ 			rcu_read_lock();
+ 			for_each_netdev_in_bond_rcu(real_dev, slave) {
+ 				port = nss_cmn_get_interface_number_by_dev(slave);
+@@ -885,6 +903,12 @@ static struct nss_vlan_pvt *nss_vlan_mgr
+ 			}
+ 			rcu_read_unlock();
+ 			v->bond_ifnum = v->parent->bond_ifnum;
++#else
++			nss_vlan_mgr_warn("%s: vlan over bond is not supported\n", dev->name);
++			nss_vlan_mgr_instance_deref(v->parent);
++			kfree(v);
++			return NULL;
++#endif
+ 		}
+ 	} else {
+ 		nss_vlan_mgr_warn("%s: don't support more than 2 vlans\n", dev->name);
+@@ -1009,6 +1033,14 @@ static int nss_vlan_mgr_register_event(s
+ 	if (!v)
+ 		return NOTIFY_DONE;
+ 
++#ifdef NSS_VLAN_MGR_QCA_PPE
++	if (v->parent || v->tpid != ETH_P_8021Q) {
++		nss_vlan_mgr_warn("%s: only single-tagged 802.1Q VLANs are supported\n", dev->name);
++		nss_vlan_mgr_instance_deref(v);
++		return NOTIFY_DONE;
++	}
++#endif
++
+ 	/*
+ 	 * Allocate the VSI here.
+ 	 */
+@@ -1039,6 +1071,25 @@ static int nss_vlan_mgr_register_event(s
+ 	}
+ 	is_bond_master = netif_is_bond_master(real_dev);
+ 
++#ifdef NSS_VLAN_MGR_QCA_PPE
++	{
++		int vsi = qca_ppe_port_vlan_vsi_get(real_dev, v->vid);
++
++		if (vsi < 0) {
++			nss_vlan_mgr_warn("%s: failed to get PPE VSI for vlan\n", dev->name);
++			goto vlan_instance_free;
++		}
++		if (nss_vlan_tx_vsi_attach_msg(v->nss_if, vsi) != NSS_TX_SUCCESS) {
++			nss_vlan_mgr_warn("%s: failed to attach VSI to vlan interface\n", dev->name);
++			qca_ppe_port_vlan_vsi_put(real_dev, v->vid);
++			goto vlan_instance_free;
++		}
++		v->qca_ppe_vsi = vsi;
++		v->qca_ppe_real_dev = real_dev;
++		qca_ppe_port_vlan_vsi_refresh(real_dev, v->vid);
++	}
++#endif
++
+ #ifdef NSS_VLAN_MGR_PPE_SUPPORT
+ 	if (!is_bond_master)
+ 		ret = nss_vlan_mgr_configure_ppe(v, dev, vsi);
diff --git a/package/qca-nss-clients/patches/0047-igs-arm-the-sync-message-wait-before-ringing-the-doorbell.patch b/package/qca-nss-clients/patches/0047-igs-arm-the-sync-message-wait-before-ringing-the-doorbell.patch
new file mode 100644
index 00000000..28c622df
--- /dev/null
+++ b/package/qca-nss-clients/patches/0047-igs-arm-the-sync-message-wait-before-ringing-the-doorbell.patch
@@ -0,0 +1,72 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] igs: arm the synchronous message wait before ringing the doorbell
+
+nss_ifb_config_msg_tx_sync() sends the IFB config message and only then sets
+the condition it is about to wait on. nss_if_tx_msg() rings the NSS doorbell,
+so the firmware is already executing, and its ACK is processed by
+nss_ifb_wake_up_cb() from the N2H softirq. An ACK that lands between the send
+and the store finds an empty wait queue; the store then re-arms a condition
+that nothing will ever clear again, and the caller sleeps out the full timeout.
+
+That timeout is NSS_IFB_MSG_TIMEOUT, which is 600*HZ - ten minutes, not the one
+minute its comment claims - and the sleep is uninterruptible. The only caller is
+nss_mirred_init(), which sends two of these per redirect, and tc installs a u32
+classifier under rtnl_lock (only cls_flower carries TCF_PROTO_OPS_DOIT_UNLOCKED),
+so a single missed ACK stalls every netlink operation on the box for ten
+minutes with no kernel output at all, and there are two chances per redirect.
+
+Arm the condition before the send. Bring the timeout down to ten seconds to
+match the sibling qdisc path: firmware turnaround is microseconds, and a
+ten-minute uninterruptible hold of rtnl_lock is not a timeout, it is an outage.
+
+This does not make the shared response slot safe against a late ACK crossing
+into the next caller's wait: nss_ifb_wake_up_cb() carries no message identity,
+so an ACK that arrives after its sender gave up clears whoever is waiting now
+and stamps that caller with someone else's verdict. Clearing the condition on
+the way out would not help - every caller re-arms it under the semaphore before
+waiting, so the value left behind is never read. That hazard is older than this
+change and needs a message identity to close; it is also gated behind an ACK
+arriving more than ten seconds late, which has never been observed on hardware.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/nss_qdisc/igs/nss_ifb.h
++++ b/nss_qdisc/igs/nss_ifb.h
+@@ -14,7 +14,7 @@
+  **************************************************************************
+  */
+ 
+-#define NSS_IFB_MSG_TIMEOUT (600*HZ)	/* 1 min timeout */
++#define NSS_IFB_MSG_TIMEOUT (10*HZ)	/* firmware turnaround is microseconds */
+ 
+ /*
+  * nss_ifb_if_config
+--- a/nss_qdisc/igs/nss_ifb.c
++++ b/nss_qdisc/igs/nss_ifb.c
+@@ -286,15 +286,25 @@
+ 	}
+ 
+ 	down(&msg_response.sem);
++
++	/*
++	 * Arm the wait before ringing the doorbell, not after: nss_if_tx_msg()
++	 * hands the message to a firmware that answers in microseconds, and the
++	 * ACK callback runs from the N2H softirq. An ACK landing between the two
++	 * finds an empty wait queue, and the store below would then re-arm a
++	 * condition nothing will ever clear again - an uninterruptible sleep for
++	 * the whole timeout with rtnl_lock held, since this is only ever reached from
++	 * act_nssmirred's init under the classifier's RTNL section.
++	 */
++	msg_response.cond = 1;
+ 	ret = nss_if_tx_msg(nss_igs_get_context(), &nim);
+ 	if (ret != NSS_TX_SUCCESS) {
+ 		up(&msg_response.sem);
+ 		nss_igs_error("failed to send config message\n");
+ 		return -1;
+ 	}
+ 
+-	msg_response.cond = 1;
+ 	if (!wait_event_timeout(msg_response.wq, msg_response.cond == 0, NSS_IFB_MSG_TIMEOUT)) {
+ 		nss_igs_error("config for attach interface msg timeout\n");
+ 		up(&msg_response.sem);
+ 		return -1;
diff --git a/package/qca-nss-clients/patches/0048-igs-unwind-firmware-state-when-a-redirect-init-fails.patch b/package/qca-nss-clients/patches/0048-igs-unwind-firmware-state-when-a-redirect-init-fails.patch
new file mode 100644
index 00000000..0400c770
--- /dev/null
+++ b/package/qca-nss-clients/patches/0048-igs-unwind-firmware-state-when-a-redirect-init-fails.patch
@@ -0,0 +1,78 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] igs: unwind firmware state when a redirect init fails
+
+nss_mirred_init() applies the IGS node and the nexthop to the source physical
+port with two synchronous messages, and only afterwards calls nss_ifb_bind(),
+which is what sets is_mapped. Either send failing returns -EINVAL with nothing
+undone.
+
+That is not recoverable later. Both undo paths, nss_ifb_reset_nexthop() and
+nss_ifb_clear_igs_node(), open with a test on is_mapped and return success
+having sent nothing when it is clear - and it is clear here, because bind never
+ran. A failed send is also not proof the firmware ignored the message: a timeout
+means only that no ACK was seen. So a redirect whose init timed out leaves a
+nexthop pointing at an IGS node on a physical port, with no host-side record of
+it and no way to take it back short of reloading the firmware. The port then
+looks perfectly healthy while its traffic goes to a node nothing feeds.
+
+Send the corresponding undo directly on both failure paths, bypassing the
+is_mapped gate that exists for the bound case. nss_ifb_clear_config_cb() has to
+tolerate a NULL app_data for that, since there is no ifb_info to update yet;
+it dereferenced it unconditionally, which would have faulted in softirq.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/nss_qdisc/igs/nss_ifb.c
++++ b/nss_qdisc/igs/nss_ifb.c
+@@ -147,6 +147,18 @@
+ 	struct nss_ifb_info *ifb_info = (struct nss_ifb_info *)app_data;
+ 	bool ret;
+ 
++	/*
++	 * A CLEAR sent to unwind a half-applied mapping has no ifb_info to
++	 * update - there is no bound entry yet. Nothing to do but check the
++	 * response.
++	 */
++	if (!ifb_info) {
++		if (nim->cm.response != NSS_CMN_RESPONSE_ACK) {
++			nss_igs_error("Response error: %d\n", nim->cm.response);
++		}
++		return;
++	}
++
+ 	if (nim->cm.response != NSS_CMN_RESPONSE_ACK) {
+ 		nss_igs_error("Response error: %d\n", nim->cm.response);
+ 		return;
+--- a/nss_qdisc/igs/nss_mirred.c
++++ b/nss_qdisc/igs/nss_mirred.c
+@@ -191,6 +191,16 @@
+ 	 */
+ 	if (nss_ifb_config_msg_tx_sync(from_dev, ifb_num, NSS_IFB_SET_IGS_NODE, NULL) < 0) {
+ 		nss_igs_error("Sending config to %s dev failed\n", from_dev->name);
++
++		/*
++		 * A failure here is not proof the firmware ignored the message:
++		 * a timeout means only that no ACK was seen, and the node may
++		 * well be applied. is_mapped is set by nss_ifb_bind() below, so
++		 * from this point the gated undo helpers would return success
++		 * having sent nothing, and the node would sit on the physical
++		 * port until the firmware is reloaded. Undo it directly.
++		 */
++		nss_ifb_config_msg_tx(from_dev, ifb_num, NSS_IFB_CLEAR_IGS_NODE, NULL);
+ 		return -EINVAL;
+ 	}
+ 
+@@ -199,6 +209,13 @@
+ 	 */
+ 	if (nss_ifb_config_msg_tx_sync(from_dev, ifb_num, NSS_IFB_SET_NEXTHOP, NULL) < 0) {
+ 		nss_igs_error("Sending next hop config to %s dev failed\n", from_dev->name);
++
++		/*
++		 * Same reasoning, and the IGS node from the send above is
++		 * definitely applied, so take both back.
++		 */
++		nss_ifb_config_msg_tx(from_dev, ifb_num, NSS_IFB_RESET_NEXTHOP, NULL);
++		nss_ifb_config_msg_tx(from_dev, ifb_num, NSS_IFB_CLEAR_IGS_NODE, NULL);
+ 		return -EINVAL;
+ 	}
+ 
diff --git a/package/qca-nss-clients/patches/0049-nss_qdisc-keep-a-codel-leaf-buildable-when-its-flow-queue-memory-is-scarce.patch b/package/qca-nss-clients/patches/0049-nss_qdisc-keep-a-codel-leaf-buildable-when-its-flow-queue-memory-is-scarce.patch
new file mode 100644
index 00000000..c3e2e26a
--- /dev/null
+++ b/package/qca-nss-clients/patches/0049-nss_qdisc-keep-a-codel-leaf-buildable-when-its-flow-queue-memory-is-scarce.patch
@@ -0,0 +1,200 @@
+nss_qdisc: keep a codel leaf buildable when its flow queue memory is scarce
+
+nssfq_codel hands the firmware one physically contiguous block for its whole
+flow queue array. At the default 1024 flows that is 128 KB, an order-5
+allocation, and orders above PAGE_ALLOC_COSTLY_ORDER are failed outright
+rather than compacted for, so a router that has been forwarding for a while
+refuses it. The qdisc went down with the allocation, which is not a survivable
+outcome here: until some leaf below the root carries set_default, the shaper
+tree drops every frame the interface is asked to transmit - ARP and PPPoE
+discovery included - so a single refused allocation took the port silently off
+the air, carrier up and nothing logged, until the next reboot. Halve the flow
+count until it fits instead, and ask the allocator to work for it first.
+
+The same function could not build a flow-queue codel at all unless the count
+was spelled out. A zero count from tc means "use the default" on nssfq_codel
+and "single queue" only on plain nsscodel, but the firmware size request was
+gated on the value rather than on the qdisc kind, so the per-flow size stayed
+zero and the allocation asked for get_order(0) - BITS_PER_LONG minus
+PAGE_SHIFT, an order nothing can satisfy. Every `tc qdisc add ... nssfq_codel`
+without an explicit `flows` therefore failed, and left the same dark tree
+behind. Resolve the effective count in one place so the size request, the
+allocation and the firmware message all agree on it, and keep the requested
+count so a later change command that repeats the original request is not
+rejected by a fallback the user never asked for.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/nss_qdisc/nss_codel.c
++++ b/nss_qdisc/nss_codel.c
+@@ -23,6 +23,12 @@
+ #define NSS_CODEL_DEFAULT_FQ_COUNT 1024
+ 
+ /*
++ * Fewest flow queues worth falling back to when the firmware's flow queue
++ * memory cannot be had at the requested size.
++ */
++#define NSS_CODEL_MIN_FQ_COUNT 64
++
++/*
+  * Codel stats structure.
+  */
+ struct nss_codel_stats_sq {
+@@ -50,7 +56,8 @@
+ 	u32 target;		/* Acceptable value of queue delay */
+ 	u32 limit;		/* Length of queue */
+ 	u32 interval;		/* Monitoring interval */
+-	u32 flows;		/* Number of flow buckets */
++	u32 flows;		/* Number of flow buckets actually in use */
++	u32 flows_req;		/* Number of flow buckets asked for */
+ 	u32 quantum;		/* Weight (in bytes) used for DRR of flow buckets */
+ 	unsigned long flow_queue_mem;
+ 				/* Pointer to flow queue memory */
+@@ -209,6 +216,25 @@
+ }
+ 
+ /*
++ * nss_codel_flow_count()
++ *	Number of flow queues this qdisc will run with.
++ *
++ * A zero flow count from tc means "use the default" on nssfq_codel and "single
++ * queue, no flow queue memory at all" on plain nsscodel. Which of the two this
++ * is decides that, never the value itself, so everything that depends on the
++ * count - whether to ask the firmware for a per-flow size, how much memory to
++ * allocate, and what to tell the firmware - resolves it here and agrees.
++ */
++static uint32_t nss_codel_flow_count(struct Qdisc *sch, struct tc_nsscodel_qopt *qopt)
++{
++	if (sch->ops != &nss_fq_codel_qdisc_ops) {
++		return 0;
++	}
++
++	return qopt->flows ? qopt->flows : NSS_CODEL_DEFAULT_FQ_COUNT;
++}
++
++/*
+  * nss_codel_mem_sz_get()
+  *	Sends a message to nss_codel queue (in FW) requesting per flow-queue mem size.
+  *
+@@ -222,8 +248,16 @@
+ 	/*
+ 	 * No memory allocation needed for codel when operating in single
+ 	 * queue mode. This is needed only for flow-queue mode.
++	 *
++	 * Testing the flow count instead of the qdisc kind skipped this request
++	 * for every nssfq_codel that left the count at its default, so
++	 * flow_queue_sz stayed zero and the allocation below went on to ask for
++	 * get_order(0) - BITS_PER_LONG minus PAGE_SHIFT, an order no allocator
++	 * can ever satisfy. Those qdiscs failed with -ENOMEM every time, and a
++	 * shaper tree whose default queue never attaches drops everything the
++	 * interface is asked to transmit.
+ 	 */
+-	if (!qopt->flows) {
++	if (!nss_codel_flow_count(sch, qopt)) {
+ 		return 0;
+ 	}
+ 
+@@ -253,7 +287,7 @@
+ 	struct tc_nsscodel_qopt *qopt;
+ 	struct nss_if_msg nim;
+ 	struct net_device *dev = qdisc_dev(sch);
+-	uint32_t order, sz = 0;
++	uint32_t order, flows, sz = 0;
+ 	bool is_fq_codel = (sch->ops == &nss_fq_codel_qdisc_ops);
+ 	struct nss_shaper_node_config *config;
+ 	bool free_flow_queue = true;
+@@ -273,12 +307,18 @@
+ 		return -EINVAL;
+ 	}
+ 
++	flows = nss_codel_flow_count(sch, qopt);
++
+ 	/*
+ 	 * If flow queues have already been allocated, then ensure the user does not
+ 	 * attempt to change the number of flows in a subsequent change command.
++	 *
++	 * This compares what was asked for both times. Comparing it against the
++	 * count in use would reject a change that repeated the original request
++	 * verbatim, whenever the allocation below had settled for fewer queues.
+ 	 */
+ 	if (q->flow_queue_mem) {
+-		if (q->flows != qopt->flows) {
++		if (q->flows_req != flows) {
+ 			nss_qdisc_warning("Change of flow queue count not allowed");
+ 			return -EINVAL;
+ 		}
+@@ -299,7 +339,7 @@
+ 	q->limit = qopt->limit;
+ 	q->interval = qopt->interval;
+ 	q->quantum = qopt->quantum;
+-	q->flows = qopt->flows;
++	q->flows_req = flows;
+ 	q->ecn = qopt->ecn;
+ 	q->set_default = qopt->set_default;
+ 
+@@ -316,27 +356,53 @@
+ 	 * has not been allocated previously (i.e. init time).
+ 	 */
+ 	if (is_fq_codel && !q->flow_queue_mem) {
++		if (!q->flow_queue_sz) {
++			nss_qdisc_warning("Firmware reported a zero flow queue size\n");
++			return -EINVAL;
++		}
++
+ 		/*
+-		 * Use the default flow queue count if value is not speficied by user.
++		 * The firmware addresses the flow queue array as one physically
++		 * contiguous block, so the whole thing has to come from a single
++		 * high-order allocation: at the default 1024 flows that is 128 KB,
++		 * order 5. Anything above PAGE_ALLOC_COSTLY_ORDER is failed rather
++		 * than compacted for, so on a router that has been forwarding for a
++		 * while this is refused - and it used to take the qdisc down with it.
++		 * That is not survivable here: a shaper tree whose default queue
++		 * never attaches drops every frame the interface is asked to
++		 * transmit, ARP and PPPoE discovery included, so one refused
++		 * allocation left the port silently off the air until the next
++		 * reboot. Ask the allocator to try harder, then halve the flow count
++		 * until it fits. Fewer hash buckets cost a little flow isolation; a
++		 * tree that cannot be built costs the link.
+ 		 */
+-		if (!q->flows) {
+-			q->flows = NSS_CODEL_DEFAULT_FQ_COUNT;
++		for (q->flows = flows; q->flows >= NSS_CODEL_MIN_FQ_COUNT; q->flows >>= 1) {
++			sz = q->flow_queue_sz * q->flows;
++			order = get_order(sz);
++
++			nss_qdisc_trace("Allocating %u bytes (%u pages) for flow qeueue\n", sz, 1 << order);
++
++			q->flow_queue_mem = __get_free_pages(GFP_KERNEL | __GFP_RETRY_MAYFAIL |
++					__GFP_NOWARN | __GFP_ZERO, order);
++			if (q->flow_queue_mem) {
++				break;
++			}
+ 		}
+ 
+-		sz = q->flow_queue_sz * q->flows;
+-		order = get_order(sz);
++		if (!q->flow_queue_mem) {
++			nss_qdisc_warning("Failed to allocate flow queue memory for %u flows\n",
++					flows);
++			return -ENOMEM;
++		}
+ 
+-		nss_qdisc_trace("Allocating %u bytes (%u pages) for flow qeueue\n", sz, 1 << order);
++		if (q->flows != flows) {
++			nss_qdisc_warning("Flow queue memory for %u flows unavailable, "
++					"shaping with %u\n", flows, q->flows);
++		}
+ 
+ 		nss_qdisc_info("Flows:%u Quantum:%u Ecn:%u\n",
+ 			q->flows, q->quantum, q->ecn);
+ 
+-		q->flow_queue_mem = __get_free_pages(GFP_KERNEL | __GFP_NOWARN | __GFP_ZERO, order);
+-		if (!q->flow_queue_mem) {
+-			nss_qdisc_warning("Failed to allocated flow queue memory\n");
+-			return -ENOMEM;
+-		}
+-
+ 		q->dma_mapped_mem = dma_map_single(nss_shaper_get_dev(), (void *)q->flow_queue_mem, sz, DMA_TO_DEVICE);
+ 		if(unlikely(dma_mapping_error(nss_shaper_get_dev(), q->dma_mapped_mem))) {
+ 			nss_qdisc_warning("DMA map failed for virtual address = %lu\n", q->flow_queue_mem);
diff --git a/package/qca-nss-clients/patches/0050-nss_qdisc-bound-two-unvalidated-indices.patch b/package/qca-nss-clients/patches/0050-nss_qdisc-bound-two-unvalidated-indices.patch
new file mode 100644
index 00000000..2dcf373e
--- /dev/null
+++ b/package/qca-nss-clients/patches/0050-nss_qdisc-bound-two-unvalidated-indices.patch
@@ -0,0 +1,90 @@
+nss_qdisc: bound the firmware stats count and the netlink traffic_id
+
+Two array walks driven by a value nobody checked.
+
+nss_qdisc_stats_sync_many_callback() iterates the shaper stats reply with
+
+	for (i = 0; i < nsnsm->count; i++)
+		nss_qdisc_stats_process_node_stats(nq, &nsnsm->stats_sync[i]);
+
+count is a uint16_t the firmware wrote and stats_sync[] is a flexible
+array. The struct carries a size field documented as "Total buffer size
+indicated by host" that the loop never reads, and the only upstream
+validation is nss_if_msg_handler()'s message-length check, computed from
+a union containing a zero-length array and so structurally independent of
+count. Records are 108 bytes, so a count of 0xffff walks ~7.1 MB past the
+PAGE_SIZE buffer nss_qdisc_stats_sync_msg_tx() sent - and any
+out-of-bounds qos_tag that hashes to a live qdisc turns those bytes into
+tc statistics output.
+
+Bound it by the buffer the host provided rather than by anything in the
+reply: the request copy's size is PAGE_SIZE, set where the message is
+built, and the record offset is fixed by the layout. Clamping keeps the
+records that did fit, which is what a truncated reply should yield.
+
+Note the reply cannot be bounded by cm.len here the way an ordinary
+message can: the request is initialised with the fixed
+sizeof(struct nss_if_shaper_configure), so cm.len describes no records at
+all and clamping to it would discard every statistic.
+
+nss_wred_change() then indexes q->nwtc[qopt->traffic_id], seven entries of
+24 bytes, with a __u32 straight off netlink - six 32-bit stores at a
+scaled attacker-chosen offset. Every sibling field in that function is
+already re-validated under a comment noting the parameters "might not
+come from tc utility"; traffic_id is the one field that reaches an array
+and the one that was left out. The macro is parenthesised at the same
+time - it is correct in a >= comparison only by operator precedence.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/nss_qdisc/nss_qdisc_stats.c
++++ b/nss_qdisc/nss_qdisc_stats.c
+@@ -462,6 +462,21 @@
+ 	wake_up(&nqsw->stats_resp_waitqueue);
+ 
+ 	if (nim->cm.response == NSS_CMN_RESPONSE_ACK) {
++		/*
++		 * count is a firmware field and stats_sync[] is a flexible
++		 * array, so bound it by the buffer the host provided - every
++		 * term below comes from our own request copy, not the reply.
++		 */
++		size_t hdr = (char *)nqsw_nsnsm->stats_sync - (char *)&nqsw->stats_sync_req_msg;
++		uint32_t max = (nqsw_nsnsm->size < hdr) ? 0 :
++			(nqsw_nsnsm->size - hdr) / sizeof(nqsw_nsnsm->stats_sync[0]);
++
++		if (nsnsm->count > max) {
++			nss_qdisc_warning("%px: stats sync count %u exceeds buffer capacity %u\n",
++					nq, nsnsm->count, max);
++			nsnsm->count = max;
++		}
++
+ 		for (i = 0; i < nsnsm->count; i++) {
+ 			nss_qdisc_stats_process_node_stats(nq, &nsnsm->stats_sync[i]);
+ 		}
+--- a/nss_qdisc/nss_wred.c
++++ b/nss_qdisc/nss_wred.c
+@@ -17,7 +17,7 @@
+ #include "nss_qdisc.h"
+ 
+ #define NSS_WRED_SUPPORT_TRAFFIC_CLASS 6
+-#define NSS_WRED_MAX_TRAFFIC_CLASS NSS_WRED_SUPPORT_TRAFFIC_CLASS+1
++#define NSS_WRED_MAX_TRAFFIC_CLASS (NSS_WRED_SUPPORT_TRAFFIC_CLASS + 1)
+ 
+ /*
+  * nsswred traffic class structure
+@@ -266,6 +266,15 @@
+ 			}
+ 			q->ecn = qopt->ecn;
+ 		}
++		/*
++		 * Every sibling field here is re-checked because the caller
++		 * need not be tc; traffic_id is the one that reaches an array.
++		 */
++		if (qopt->traffic_id >= NSS_WRED_MAX_TRAFFIC_CLASS) {
++			nss_qdisc_error("nsswred %x traffic_id %u out of range\n", sch->handle, qopt->traffic_id);
++			return -EINVAL;
++		}
++
+ 		q->nwtc[qopt->traffic_id].limit = qopt->limit;
+ 		q->nwtc[qopt->traffic_id].weight_mode_value = qopt->weight_mode_value;
+ 		q->nwtc[qopt->traffic_id].rap.min = qopt->rap.min;
diff --git a/package/qca-nss-clients/patches/0051-nss_qdisc-zero-the-dump-structs-before-copying-them-out.patch b/package/qca-nss-clients/patches/0051-nss_qdisc-zero-the-dump-structs-before-copying-them-out.patch
new file mode 100644
index 00000000..6fcc702b
--- /dev/null
+++ b/package/qca-nss-clients/patches/0051-nss_qdisc-zero-the-dump-structs-before-copying-them-out.patch
@@ -0,0 +1,159 @@
+nss_qdisc: zero the dump structs before copying them out
+
+Every nss_qdisc dump builds its reply in an uninitialised stack object and
+hands the whole object to userspace:
+
+	struct tc_nsstbl_qopt opt;
+
+	opt.rate = q->rate;
+	...
+	if (opts == NULL || nla_put(skb, TCA_NSSTBL_PARMS, sizeof(opt), &opt)) {
+
+Whatever the padding holds goes out with it. Seven of the uapi structs
+carry padding the dumps never write: tc_nsstbl_qopt, tc_nssprio_qopt and
+tc_nsshtb_qopt three bytes each, tc_nssfifo_qopt two, and
+tc_nsswred_qopt, tc_nsscodel_qopt and tc_nssbf_qopt one - all of it from
+a __u8 accel_mode following __u32 members. nss_wred_dump() additionally
+leaves members unassigned on the branch it does not take.
+
