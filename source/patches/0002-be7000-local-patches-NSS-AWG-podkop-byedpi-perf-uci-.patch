diff --git a/package/qca-nss-ecm/patches/0043-ecm_tracker-reject-a-total-length-below-the-ip-header.patch b/package/qca-nss-ecm/patches/0043-ecm_tracker-reject-a-total-length-below-the-ip-header.patch
new file mode 100644
index 00000000..d7397552
--- /dev/null
+++ b/package/qca-nss-ecm/patches/0043-ecm_tracker-reject-a-total-length-below-the-ip-header.patch
@@ -0,0 +1,40 @@
+ecm_tracker: reject a total length below the IP header length
+
+ecm_tracker_ip_check_header_and_read() validates the IPv4 header two
+ways - ihl at least 20, and skb->len at least tot_len - and then computes
+
+	remain = ip_hdr->total_length - ip_hdr->ip_header_length;
+
+into a uint16_t. Nothing relates the two operands, so a frame whose
+tot_len is smaller than its ihl underflows remain to nearly 64 KB, and
+that value is handed to every per-protocol header helper as the amount of
+packet left to parse.
+
+Both operands are attacker-chosen and the two existing checks pass
+happily: ihl = 15 (60 bytes) with tot_len = 40 satisfies "ihl >= 20" and
+"skb->len >= tot_len" on any ordinary frame.
+
+One raw Ethernet frame from any bridged LAN or Wi-Fi client reaches it -
+ECM inspects every flow it might accelerate.
+
+Bound the subtraction by its own operands, next to the checks that
+already guard it. The IPv6 branch takes remain straight from
+payload_len and does not subtract, so it has no sibling defect.
+
+Found by a coverage-guided ASan harness over the tracker entry point.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/ecm_tracker.c
++++ b/ecm_tracker.c
+@@ -465,6 +465,10 @@
+ 			DEBUG_WARN("%px: v4 invalid total len: %u skb len: %u\n", skb, ip_hdr->total_length, skb->len);
+ 			return false;
+ 		}
++		if (ip_hdr->total_length < ip_hdr->ip_header_length) {
++			DEBUG_WARN("%px: v4 total len %u below ip hdr len %u\n", skb, ip_hdr->total_length, ip_hdr->ip_header_length);
++			return false;
++		}
+ 		remain = ip_hdr->total_length - ip_hdr->ip_header_length;
+ 
+ 		/*
diff --git a/package/qca-nss-ecm/patches/0044-frontends-nss-do-not-window-check-an-accelerated-connection.patch b/package/qca-nss-ecm/patches/0044-frontends-nss-do-not-window-check-an-accelerated-connection.patch
new file mode 100644
index 00000000..ad292f76
--- /dev/null
+++ b/package/qca-nss-ecm/patches/0044-frontends-nss-do-not-window-check-an-accelerated-connection.patch
@@ -0,0 +1,112 @@
+frontends/nss: stop conntrack window-checking a connection it no longer sees
+
+Conntrack stops seeing a connection's packets the moment the firmware starts
+forwarding them. Its TCP window state therefore freezes at the last packet
+that went through the host, and is advanced again only by the stats sync,
+once a second (ECM_NSS_IPV4_STATS_SYNC_PERIOD).
+
+Any packet that returns to the host path inside that window is judged against
+a window that can be thousands of bytes behind: a slow-path exception, the
+first packet after a deceleration, or simply a short flow that completes
+between two syncs. tcp_in_window() fails it, conntrack marks it INVALID, and
+OpenWrt's stock egress rule for a masqueraded zone
+
+	oifname "wan" ct state invalid ... drop
+
+drops it. Nothing records the loss, because from the stack's point of view the
+firewall did its job.
+
+Marking the connection liberal is what the kernel's own offload paths do for
+the same reason - nft_flow_offload.c, act_ct.c and xt_FLOWOFFLOAD.c all set
+IP_CT_TCP_FLAG_BE_LIBERAL on both directions when they take a flow away from
+conntrack, and nf_conntrack_proto_tcp.c reads it before the pernet sysctls.
+Doing it per connection keeps window validation for every flow the firmware is
+not carrying, which the global nf_conntrack_tcp_no_window_check switch does
+not.
+
+The flag has to be hidden from the NO_SEQ_CHECK test above it. That test asks
+whether conntrack's window numbers are worth enforcing, and answers yes unless
+something already marked the connection liberal - a mid-stream pickup, where
+tcp_new() sets the flag because conntrack has no window state to give. Our own
+flag must not answer that question: ECM hands the firmware real window numbers
+from the last sync, and the firmware sees every accelerated packet, so it stays
+the one party able to check them. Without the guard the first acceleration is
+fine and every re-acceleration - the same nf_conn re-entering this path after a
+decel - would read our flag back and silently switch the firmware's sequence
+checking off for the rest of the connection's life.
+
+The flag is deliberately not cleared on deceleration: the packets that follow
+one are exactly the packets this protects.
+
+IPv4 and IPv6 are line-for-line identical here and change together.
+
+Reported-by: Manuel Fombuena <fombuena@outlook.com>
+Co-developed-by: Manuel Fombuena <fombuena@outlook.com>
+Signed-off-by: Manuel Fombuena <fombuena@outlook.com>
+Assisted-by: Claude:claude-opus-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+
+--- a/frontends/include/ecm_front_end_types.h
++++ b/frontends/include/ecm_front_end_types.h
+@@ -305,6 +305,7 @@ struct ecm_front_end_connection_instance
+ 	bool destroy_fail_handle_pending;			/* Set while handling the connection destroy failure */
+ 	bool udp_flow_dir_accel;				/* If the UDP flow is accelerated in flow direction. */
+ 	bool udp_return_dir_accel;				/* If the UDP flow is accelerated in return direction. */
++	bool tcp_be_liberal_set;				/* True once we marked this connection's conntrack liberal */
+ 	atomic64_t unidir_accel_fail_reason;				/* Unidirection accel fail reason */
+ #ifdef ECM_FRONT_END_PPE_ENABLE
+ 	atomic64_t ppe_accel_fail_reason;			/* PPE accel fail reason */
+--- a/frontends/nss/ecm_nss_ported_ipv4.c
++++ b/frontends/nss/ecm_nss_ported_ipv4.c
+@@ -1398,10 +1398,22 @@ static void ecm_nss_ported_ipv4_connectio
+ #else
+ 			if (tcp_be_liberal
+ #endif
+-					|| (ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
+-					|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)) {
++					|| (!feci->tcp_be_liberal_set
++						&& ((ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
++							|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)))) {
+ 				nircm->rule_flags |= NSS_IPV4_RULE_CREATE_FLAG_NO_SEQ_CHECK;
+ 			}
++
++			/*
++			 * The firmware forwards this connection from here and conntrack stops
++			 * seeing it, so its window freezes until the next stats sync and a
++			 * packet excepted back to the host reads as invalid. Set after the
++			 * test above, and hidden from it, so that relaxing conntrack does not
++			 * also switch off the firmware's own sequence check.
++			 */
++			ct->proto.tcp.seen[flow_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
++			ct->proto.tcp.seen[return_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
++			feci->tcp_be_liberal_set = true;
+ 			spin_unlock_bh(&ct->lock);
+ 		}
+ 
+--- a/frontends/nss/ecm_nss_ported_ipv6.c
++++ b/frontends/nss/ecm_nss_ported_ipv6.c
+@@ -1325,10 +1325,22 @@ static void ecm_nss_ported_ipv6_connectio
+ #else
+ 			if (tcp_be_liberal
+ #endif
+-					|| (ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
+-					|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)) {
++					|| (!feci->tcp_be_liberal_set
++						&& ((ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
++							|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)))) {
+ 				nircm->rule_flags |= NSS_IPV6_RULE_CREATE_FLAG_NO_SEQ_CHECK;
+ 			}
++
++			/*
++			 * The firmware forwards this connection from here and conntrack stops
++			 * seeing it, so its window freezes until the next stats sync and a
++			 * packet excepted back to the host reads as invalid. Set after the
++			 * test above, and hidden from it, so that relaxing conntrack does not
++			 * also switch off the firmware's own sequence check.
++			 */
++			ct->proto.tcp.seen[flow_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
++			ct->proto.tcp.seen[return_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
++			feci->tcp_be_liberal_set = true;
+ 			spin_unlock_bh(&ct->lock);
+ 		}
+ 
diff --git a/package/qca-nss-ecm/patches/0045-ecm_interface-classify-a-header-less-modem-as-raw-ip.patch b/package/qca-nss-ecm/patches/0045-ecm_interface-classify-a-header-less-modem-as-raw-ip.patch
new file mode 100644
index 00000000..2e45a38d
--- /dev/null
+++ b/package/qca-nss-ecm/patches/0045-ecm_interface-classify-a-header-less-modem-as-raw-ip.patch
@@ -0,0 +1,105 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ecm_interface: classify a header-less modem as raw IP
+
+The raw-IP interface type is recognised by ARPHRD_RAWIP alone, which
+rmnet, MHI and MBIM devices declare. A QMI modem in raw-IP mode does
+not: qmi_wwan_netdev_setup() drops the header operations, the header
+length and the address length but leaves the type at ARPHRD_NONE, and
+that is the WAN interface of every USB-attached cellular router.
+
+Such a device reaches the end of the interface type ladder as unknown,
+and an unknown interface never sets the node-address done flag, so
+ecm_ipv4_node_establish_and_ref() and its IPv6 counterpart fail and the
+connection is never offered to the acceleration engine.
+
+Recognise a raw-IP device by what it carries rather than by its ARP
+type. ARPHRD_NONE with no header, no address and no rtnl link operations
+also describes the software translators - nat46 builds exactly that
+shape - so the parent device a modem bus sets is what tells the two
+apart: a translator has none.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+Assisted-by: Claude Opus 5 (1M context)
+---
+--- a/ecm_interface.h
++++ b/ecm_interface.h
+@@ -35,6 +35,26 @@
+ #define ECM_INTERFACE_LOOPBACK_DEV_INDEX 1
+ 
+ /*
++ * ecm_interface_is_rawip()
++ *	Determine whether a net device carries bare IP with no link-layer header.
++ *
++ * rmnet, MHI and MBIM devices declare ARPHRD_RAWIP. A QMI modem in raw-IP mode
++ * leaves the type at ARPHRD_NONE with no header and no address, which the
++ * software translators use as well; only a device a modem bus created has a
++ * parent, which separates the two.
++ */
++static inline bool ecm_interface_is_rawip(struct net_device *dev)
++{
++	if (dev->type == ARPHRD_RAWIP) {
++		return true;
++	}
++
++	return dev->type == ARPHRD_NONE && dev->dev.parent
++		&& !dev->rtnl_link_ops && !dev->hard_header_len
++		&& !dev->addr_len;
++}
++
++/*
+  * IPSec Core and Interface Definition
+  */
+ #define ECM_INTERFACE_IPSEC_DEFAULT_CORE 0x2
+--- a/ecm_interface.c
++++ b/ecm_interface.c
