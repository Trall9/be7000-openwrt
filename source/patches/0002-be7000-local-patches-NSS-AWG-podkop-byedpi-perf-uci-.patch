+	# Публичная сборка: на чистой установке Wi-Fi сразу включён, но НЕ открытый.
+	# Пароль по умолчанию — в README; сменить при первой настройке.
+	# Если сеть уже кто-то настроил (задано шифрование) — не трогаем.
+	local r enc configured=0
+	for r in 0 1; do
+		enc="$(uci -q get wireless.default_radio$r.encryption)"
