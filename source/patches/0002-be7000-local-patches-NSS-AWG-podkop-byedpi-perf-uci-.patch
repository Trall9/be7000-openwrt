+ * Permission to use, copy, modify, and/or distribute this software for
+ * any purpose with or without fee is hereby granted, provided that the
+ * above copyright notice and this permission notice appear in all copies.
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT
+ * OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ **************************************************************************
+ */
+
+/* DSCP remark handling conntrack extension registration. */
+
+#include <linux/netfilter.h>
+#include <linux/slab.h>
+#include <linux/kernel.h>
+#include <linux/moduleparam.h>
+#include <linux/export.h>
+
+#include <net/netfilter/nf_conntrack.h>
+#include <net/netfilter/nf_conntrack_extend.h>
+#include <net/netfilter/nf_conntrack_dscpremark_ext.h>
+
+/* nf_conntrack_dscpremark_ext_set_dscp_rule_valid()
+ *	Set DSCP rule validity flag in the extension
+ */
+int nf_conntrack_dscpremark_ext_set_dscp_rule_valid(struct nf_conn *ct)
+{
+	struct nf_ct_dscpremark_ext *ncde;
+
+	ncde = nf_ct_dscpremark_ext_find(ct);
+	if (!ncde)
+		return -1;
+
+	ncde->rule_flags = NF_CT_DSCPREMARK_EXT_DSCP_RULE_VALID;
+	return 0;
+}
+EXPORT_SYMBOL(nf_conntrack_dscpremark_ext_set_dscp_rule_valid);
+
+/* nf_conntrack_dscpremark_ext_get_dscp_rule_validity()
+ *	Check if the DSCP rule flag is valid from the extension
+ */
+int nf_conntrack_dscpremark_ext_get_dscp_rule_validity(struct nf_conn *ct)
+{
+	struct nf_ct_dscpremark_ext *ncde;
+
+	ncde = nf_ct_dscpremark_ext_find(ct);
+	if (!ncde)
+		return NF_CT_DSCPREMARK_EXT_RULE_NOT_VALID;
+
+	if (ncde->rule_flags & NF_CT_DSCPREMARK_EXT_DSCP_RULE_VALID)
+		return NF_CT_DSCPREMARK_EXT_RULE_VALID;
+
+	return NF_CT_DSCPREMARK_EXT_RULE_NOT_VALID;
+}
+EXPORT_SYMBOL(nf_conntrack_dscpremark_ext_get_dscp_rule_validity);
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be7000_boot_success b/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be7000_boot_success
index f08db9b7..bfbbe3a3 100755
--- a/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be7000_boot_success
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be7000_boot_success
@@ -33,22 +33,24 @@ boot() {
 		echo "/dev/mtd$mtdnum 0x0 0x10000 0x20000" > /etc/fw_env.config
 	fi
 
-	case "$(sed -n 's/.*ubi.mtd=\([^ ]*\).*/\1/p' /proc/cmdline)" in
-	rootfs_1)
-		slot=1
-		;;
-	rootfs)
-		slot=0
-		;;
-	*)
-		return 0
-		;;
-	esac
-
-	fw_setenv flag_boot_rootfs "$slot" || return 0
-	fw_setenv flag_last_success "$slot" || return 0
-	fw_setenv flag_boot_success 1 || return 0
-	fw_setenv flag_try_sys1_failed 0 || return 0
-	fw_setenv flag_try_sys2_failed 0 || return 0
-	fw_setenv flag_ota_reboot 0 || return 0
+	# Слот — слово за словом: жадный sed может зацепить лишний ubi.mtd=
+	# (ловушка из be7000-bootconfirm timofey-maykov v1.2.3).
+	local arg slot=""
+	for arg in $(cat /proc/cmdline); do
+		case "$arg" in
+		ubi.mtd=rootfs_1) slot=1; break ;;
+		ubi.mtd=rootfs)   slot=0; break ;;
+		esac
+	done
+	[ -n "$slot" ] || { logger -t boot_success "no ubi.mtd=rootfs* on cmdline, flags left alone"; return 0; }
+
+	for f in flag_boot_rootfs:$slot flag_last_success:$slot flag_boot_success:1 \
+		flag_try_sys1_failed:0 flag_try_sys2_failed:0 flag_ota_reboot:0; do
+		local k="${f%%:*}" v="${f#*:}"
+		[ "$(fw_printenv -n "$k" 2>/dev/null)" = "$v" ] && continue
+		fw_setenv "$k" "$v" 2>/dev/null \
+			|| logger -t boot_success "could not set $k=$v"
+		[ "$(fw_printenv -n "$k" 2>/dev/null)" = "$v" ] \
+			|| logger -t boot_success "$k did not stick at $v"
+	done
 }
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/18_be7000_uapsd_off b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/18_be7000_uapsd_off
new file mode 100644
index 00000000..144ba116
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/18_be7000_uapsd_off
@@ -0,0 +1,14 @@
+#!/bin/sh
+# BE7000: отключить U-APSD advertisement на всех AP-интерфейсах.
+# Причина: клиенты Windows с U-APSD периодически засыпают между пачками ->
+# секундные провалы аплинка (757M средний с dips до 370M). После отключения:
+# UL стабильно 1.04-1.31G (среднее 1.20G). Замер 26.09, ноут 2x2 HE-MCS11/160.
+[ "$(board_name)" = "xiaomi,be7000" ] || exit 0
+
+for ifc in $(uci -q show wireless | sed -n 's/^wireless\.\(.*\)=wifi-iface$/\1/p'); do
+	[ "$(uci -q get wireless.$ifc.mode)" = "ap" ] || continue
+	uci -q set wireless.$ifc.uapsd_advertisement_enabled='0'
+done
+
+uci -q commit wireless
+exit 0
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/19_be7000_flow_offload b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/19_be7000_flow_offload
new file mode 100644
index 00000000..1203e698
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/19_be7000_flow_offload
@@ -0,0 +1,9 @@
+#!/bin/sh
+# BE7000: включить software flow offload (nft flowtable) на br-lan<->wan.
+# Замер 26.09: на speedtest не влияет (узкое место — драйвер ath12k), но
+# снимает conntrack/NAT с CPU на форвардинге. Cake SQM продолжает шейпить.
+[ "$(board_name)" = "xiaomi,be7000" ] || exit 0
+
+uci -q set firewall.@defaults[0].flow_offloading='1'
+uci -q commit firewall
+exit 0
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/20_be7000_cpu_perf b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/20_be7000_cpu_perf
new file mode 100644
index 00000000..371678a6
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/20_be7000_cpu_perf
@@ -0,0 +1,13 @@
+#!/bin/sh
+# BE7000: CPU governor = performance (+ автоприменение на каждом буте).
+# Замер 26.09: schedutil держал ядра на 936-1104 МГц под гигабитным трафиком.
+# Аппаратный потолок экземпляра = 1488 МГц (speedbin=1, фьюз qfprom 0x15, биты 7-8).
+[ "$(board_name)" = "xiaomi,be7000" ] || exit 0
+
+for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
+	[ -e "$c" ] && echo performance > "$c" 2>/dev/null
+done
+
+LINE='for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > $c; done'
+grep -qsF "$LINE" /etc/rc.local || sed -i "/^exit 0/i $LINE" /etc/rc.local
+exit 0
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/21_be7000_net_perf b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/21_be7000_net_perf
new file mode 100644
index 00000000..8882c92f
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/uci-defaults/21_be7000_net_perf
@@ -0,0 +1,39 @@
+#!/bin/sh
+# BE7000: сетевой тюнинг Wi-Fi (итоги 26.09, суммарно +25-35% DL).
+# 1) packet steering; 2) AQL txq limits x6 (mac80211 дефолты 5000/12000
+#    душили TX на PHY 2402); 3) RPS/XPS на все ядра; 4) ath12k data IRQ
+#    пиннинг (иначе всё висит на CPU0). Прописывает строки в /etc/rc.local.
+[ "$(board_name)" = "xiaomi,be7000" ] || exit 0
+
+uci -q set network.globals.packet_steering='1'
+uci -q commit network
+
+AQL_LINE='# WiFi perf: AQL txq limits + RPS/XPS + IRQ pinning (26.09, +25% DL)'
+if ! grep -qsF "$AQL_LINE" /etc/rc.local; then
+	cat >> /etc/rc.local << EOF
+
+$AQL_LINE
+( n=0; while [ \$n -lt 30 ] && [ ! -e /sys/kernel/debug/ieee80211/phy1/aql_txq_limit ]; do sleep 1; n=\$((n+1)); done
+  for p in phy0 phy1; do f=/sys/kernel/debug/ieee80211/\$p/aql_txq_limit; [ -e \$f ] || continue
+    i=0; while [ \$i -lt 4 ]; do echo "\$i 1000000 1000000" > \$f; i=\$((i+1)); done
+  done ) &
+for q in /sys/class/net/*/queues/rx-*/rps_cpus; do echo f > \$q 2>/dev/null; done
+for q in /sys/class/net/*/queues/tx-*/xps_cpus; do echo f > \$q 2>/dev/null; done
+( n=0; while [ \$n -lt 30 ] && ! grep -q "DP_EXT_IRQ" /proc/interrupts; do sleep 1; n=\$((n+1)); done
+  i=0
+  grep -E "DP_EXT_IRQ|ce1," /proc/interrupts | while read -r line; do
+    set -- \$line; irq=\${1%:}
+    case \$((i % 3)) in 0) m=2;; 1) m=4;; *) m=8;; esac
+    echo \$m > /proc/irq/\$irq/smp_affinity 2>/dev/null
+    i=\$((i+1))
+  done ) &
+EOF
+fi
+# Блок выше дописывается В КОНЕЦ файла — то есть после штатного «exit 0», и
+# никогда не выполнялся. Переносим exit 0 в самый конец (чинит и rc.local,
+# восстановленный из старого бэкапа).
+if grep -q '^exit 0$' /etc/rc.local && [ "$(tail -n1 /etc/rc.local)" != "exit 0" ]; then
+	sed -i '/^exit 0$/d' /etc/rc.local
+	echo 'exit 0' >> /etc/rc.local
+fi
