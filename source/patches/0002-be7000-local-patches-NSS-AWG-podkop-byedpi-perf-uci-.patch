new file mode 100644
index 00000000..9d407bda
--- /dev/null
+++ b/package/byedpi/Makefile
@@ -0,0 +1,55 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=byedpi
+PKG_VERSION:=0.17.3
+PKG_RELEASE:=1
+
+PKG_SOURCE_PROTO:=git
+PKG_SOURCE_URL:=https://github.com/hufrea/byedpi.git
+PKG_SOURCE_VERSION:=v$(PKG_VERSION)
+PKG_MIRROR_HASH:=skip
+
+PKG_MAINTAINER:=
+PKG_LICENSE:=MIT
+PKG_LICENSE_FILES:=LICENSE
+
+PKG_BUILD_PARALLEL:=1
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/byedpi
+	SECTION:=net
+	CATEGORY:=Network
+	SUBMENU:=Web Servers/Proxies
+	TITLE:=ByeDPI - local SOCKS5 proxy with DPI evasion
+	URL:=https://github.com/hufrea/byedpi
+	DEPENDS:=+libc
+endef
+
+define Package/byedpi/description
+	ByeDPI (ciadpi) — локальный SOCKS5-прокси, обходящий DPI
+	путём разбиения/модификации/перестановки пакетов.
+	Настройка: /etc/config/byedpi (enabled, ip, port, extra_args).
+	Для прозрачного режима добавьте nftables-редирект на порт прокси
+	(см. https://github.com/hufrea/byedpi).
+	По умолчанию ВЫКЛЮЧЕН.
+endef
+
+define Build/Compile
+	$(TARGET_CONFIGURE_OPTS) \
+	$(MAKE) -C $(PKG_BUILD_DIR) \
+		CC="$(TARGET_CC)" \
+		CFLAGS="$(TARGET_CFLAGS) -std=c99 -I. -O2" \
+		LDFLAGS="$(TARGET_LDFLAGS)"
+endef
+
+define Package/byedpi/install
+	$(INSTALL_DIR) $(1)/usr/bin
+	$(INSTALL_BIN) $(PKG_BUILD_DIR)/ciadpi $(1)/usr/bin/ciadpi
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./files/etc/init.d/byedpi $(1)/etc/init.d/byedpi
+	$(INSTALL_DIR) $(1)/etc/config
+	$(INSTALL_CONF) ./files/etc/config/byedpi $(1)/etc/config/byedpi
+endef
+
+$(eval $(call BuildPackage,byedpi))
