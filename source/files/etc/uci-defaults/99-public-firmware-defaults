#!/bin/sh
# Публичная прошивка BE7000: всё ПО установлено, но сервисы обхода блокировок
# по умолчанию ВЫКЛЮЧЕНЫ — пользователь включает и настраивает сам в LuCI.
# (podkop по умолчанию подменяет DNS на 77.88.8.8 и перехватывает dnsmasq —
#  не должен активироваться без явной настройки профиля владельцем роутера.)

for svc in podkop sing-box byedpi; do
	if [ -x /etc/init.d/$svc ]; then
		/etc/init.d/$svc stop >/dev/null 2>&1
		/etc/init.d/$svc disable >/dev/null 2>&1
	fi
done

exit 0
