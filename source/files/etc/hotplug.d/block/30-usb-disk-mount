case "$ACTION" in
  add) ;;
  *) exit 0;;
esac
case "$DEVNAME" in
  sd[a-z][0-9]) ;;
  *) exit 0;;
esac
# BE7000: при загрузке — после подъёма 5 ГГц, в фоне (см. /usr/libexec/be7000-wait-5g)
if [ -z "$WAITED_5G" ] && [ -x /usr/libexec/be7000-wait-5g ] && /usr/libexec/be7000-wait-5g check; then
	( /usr/libexec/be7000-wait-5g; WAITED_5G=1 sh /etc/hotplug.d/block/30-usb-disk-mount ) </dev/null >/dev/null 2>&1 &
	exit 0
fi
sleep 2
TYPE=$(blkid -o value -s TYPE /dev/$DEVNAME 2>/dev/null)
# уже смонтирован (например, это /overlay на диске) — не трогаем
grep -q "^/dev/$DEVNAME " /proc/mounts && exit 0
# раздел extroot не монтируем в /mnt: его подключает fstools или be7000-extroot
EXT=$(uci -q get fstab.extroot.uuid)
[ -n "$EXT" ] && [ "$(blkid -o value -s UUID /dev/$DEVNAME 2>/dev/null)" = "$EXT" ] && exit 0
MP=/mnt/$DEVNAME
mkdir -p $MP
grep -q " $MP " /proc/mounts && exit 0
case "$TYPE" in
  ntfs)
	if ! mount -t ntfs3 -o rw,uid=0,gid=0,umask=000 /dev/$DEVNAME $MP 2>/dev/null; then
		[ -x /usr/bin/scanvol ] && /usr/bin/scanvol /dev/$DEVNAME clear >/dev/null 2>&1
		mount -t ntfs3 -o rw,uid=0,gid=0,umask=000 /dev/$DEVNAME $MP 2>/dev/null ||
		mount -t ntfs3 -o force,rw,uid=0,gid=0,umask=000 /dev/$DEVNAME $MP 2>/dev/null
	fi;;
  vfat|exfat) mount -o rw,uid=0,gid=0,umask=000 /dev/$DEVNAME $MP 2>/dev/null;;
  ext4) mount -o rw /dev/$DEVNAME $MP 2>/dev/null;;
esac
grep -q " $MP " /proc/mounts && logger -t usb-automount "$DEVNAME mounted to $MP"
